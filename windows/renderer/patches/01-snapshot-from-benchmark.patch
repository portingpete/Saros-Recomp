index 0000000000000000000000000000000000000000..0e86234f1d35e0e61c07affd40e3b6eb66474222
--- /dev/null
+++ b/core/kyty/graphics/host_gpu/renderer/SarosDispatchTimer.h
@@ -0,0 +1,92 @@
+#pragma once
+
+#include "graphics/host_gpu/graphicContext.h"
+#include "graphics/guest_gpu/graphicsRun.h"
+#include "graphics/host_gpu/renderer/commandRecorder.h"
+#include "graphics/host_gpu/renderer/commandScheduler.h"
+#include "graphics/host_gpu/renderer/renderContext.h"
+#include <atomic>
+#include <cinttypes>
+#include <cstdio>
+#include <cstdlib>
+#include <string_view>
+#include <vector>
+
+namespace Libs::Graphics {
+// Private diagnostic for the Saros CS whose registered bytes begin with this Kyty code record.
+inline constexpr uint64_t SarosTargetCode = 0xda869f9de8f33148ull;
+
+inline vk::QueryPool BeginSarosDispatchSample(RenderContext& context, const CommandRecorder& command, uint64_t code) {
+	static const bool enabled = [] {
+		const char* value = std::getenv("KYTY_SAROS_DISPATCH_TIMER");
+		return value && std::string_view(value) == "1";
+	}();
+	if (!enabled) return {};
+	static const auto extra = [] {
+		const char* value = std::getenv("KYTY_EXTRA_TIMED_SHADER");
+		return value == nullptr ? 0ull : std::strtoull(value, nullptr, 16);
+	}();
+	if (code != SarosTargetCode && code != extra) {
+		const int frame = context.GetGpu().GetFrameNum();
+		if (frame <= 0 || frame % 60 != 0) return {};
+		static thread_local int last_frame = -1;
+		static thread_local unsigned count = 0;
+		if (last_frame != frame) { last_frame = frame; count = 0; }
+		static const unsigned limit = [] {
+			const char* value = std::getenv("KYTY_SAROS_FULL_CENSUS");
+			return value && std::string_view(value) == "1" ? 4096u : 512u;
+		}();
+		if (count >= limit) {
+			if (count == limit) std::fprintf(stderr, "[saros-gpu-clock] census truncated frame=%d\n", frame);
+			++count;
+			return {};
+		}
+		++count;
+	}
+	auto& graphics = context.GetGraphics();
+	static const bool supported = [&] {
+		uint32_t count = 0;
+		graphics.physical_device.getQueueFamilyProperties(&count, nullptr);
+		std::vector<vk::QueueFamilyProperties> families(count);
+		graphics.physical_device.getQueueFamilyProperties(&count, families.data());
+		const auto bits = graphics.queue_family < count ? families[graphics.queue_family].timestampValidBits : 0;
+		std::fprintf(stderr, "[saros-gpu-clock] queue_bits=%u timestamp_ns=%.6f\n", bits,
+		             graphics.physical_device_properties.limits.timestampPeriod);
+		return bits == 64;
+	}();
+	if (!supported) return {};
+	vk::QueryPoolCreateInfo info {};
+	info.queryType = vk::QueryType::eTimestamp;
+	info.queryCount = 2;
+	vk::QueryPool pool {};
+	if (graphics.device.createQueryPool(&info, nullptr, &pool) != vk::Result::eSuccess) {
+		std::fprintf(stderr, "[saros-gpu-clock] query allocation failed\n");
+		return {};
+	}
+	command.sarosDispatchTimestamp(pool, true);
+	return pool;
+}
+
+inline void EndSarosDispatchSample(RenderContext& context, const CommandRecorder& command, vk::QueryPool pool,
+                                   uint64_t frame, uint64_t code, const char* path) {
+	if (!pool) return;
+	command.sarosDispatchTimestamp(pool, false);
+	const auto device = context.GetGraphics().device;
+	const double period = context.GetGraphics().physical_device_properties.limits.timestampPeriod;
+	auto& scheduler = context.GetCommandScheduler();
+	const auto tick = scheduler.CurrentTick();
+	scheduler.DeferHostOperation([=] {
+		uint64_t clocks[2] {};
+		const auto result = device.getQueryPoolResults(pool, 0, 2, sizeof(clocks), clocks, sizeof(uint64_t),
+		                                                vk::QueryResultFlagBits::e64);
+		if (result == vk::Result::eSuccess) {
+			std::fprintf(stderr, "[saros-gpu-clock] frame=%" PRIu64 " tick=%" PRIu64 " code=%016" PRIx64 " path=%s gpu_ns=%.0f\n",
+			             frame, tick, code, path, static_cast<double>(clocks[1] - clocks[0]) * period);
+		} else {
+			std::fprintf(stderr, "[saros-gpu-clock] unavailable after completed tick=%" PRIu64 " result=%d\n",
+			             tick, static_cast<int>(result));
+		}
+		device.destroyQueryPool(pool, nullptr);
+	});
+}
+}
