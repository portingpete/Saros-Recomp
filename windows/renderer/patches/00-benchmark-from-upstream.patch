+    std::optional<AgcDriver::DisplayBuffer> Source() override {
+        KytyDllDisplayBuffer source{};
+        bool has = false;
+        Check(Host(__func__)->flip_source(m_request, &source, &has));
+        if (!has) return std::nullopt;
+        return ToBuffer(source);
