-				}
-				continue;
-			}
-			manifest.pipelines.push_back(pipeline);
-		} else if (tokens[0] == "T") {
-			std::pair<uint64_t, ShaderTessellationInputInfo> layout;
-			if (ReadLayout(std::span(tokens).subspan(1), layout)) {
