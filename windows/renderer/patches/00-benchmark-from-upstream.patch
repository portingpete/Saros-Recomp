+std::size_t CopyPath(const std::filesystem::path& path, char* resolved, std::size_t capacity) {
+    const auto text = path.u8string();
+    if (resolved != nullptr && text.size() <= capacity) std::memcpy(resolved, text.data(), text.size());
+    return text.size();
+}
