+            continue;
+        case '\f':
+            NKWebKit::WtfAbi::AppendCString(builder, "\\f");
+            continue;
+        case '\n':
+            NKWebKit::WtfAbi::AppendCString(builder, "\\n");
+            continue;
+        case '\r':
+            NKWebKit::WtfAbi::AppendCString(builder, "\\r");
+            continue;
+        case '\t':
+            NKWebKit::WtfAbi::AppendCString(builder, "\\t");
+            continue;
+        case '\\':
+            NKWebKit::WtfAbi::AppendCString(builder, "\\\\");
+            continue;
+        case '"':
