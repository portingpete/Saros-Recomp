+    ("stage", 5, "<"),
+    ("wave", 4, ">"),
+    ("group", 9, "<"),
+    ("isects", 6, ">"),
+    ("native", 6, ">"),
+    ("oracle", 6, ">"),
+    ("lane", 4, ">"),
+    ("empty", 5, ">"),
+    ("emulated", 8, ">"),
+    ("spirv", 7, "<"),
+    ("status", 0, "<"),
+)
+BUILD_COMMAND = "cmake --build build --target kyty_rt_probe"
