-		if (tokens.size() < 2 || tokens[0] != "M") continue;
-		ManifestModule module;
-		if (!ReadModule(std::span(tokens).subspan(2), module) ||
-		    !modules.emplace(tokens[1], static_cast<uint32_t>(manifest.modules.size())).second) {
