+
+def identity():
+    names = set()
+    try:
+        names.add(Path.home().name)
+    except (RuntimeError, KeyError):
+        pass
+    for key in ("USER", "USERNAME", "LOGNAME"):
+        if os.environ.get(key):
+            names.add(os.environ[key])
