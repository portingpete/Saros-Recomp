+    static std::string Message(std::exception_ptr error) noexcept {
+        try {
+            if (error) std::rethrow_exception(error);
+        } catch (const std::exception& failure) {
+            return failure.what();
+        } catch (...) {
+        }
+        return "kyty_gpu: flip failed";
+    }
+
+private:
+    KytyDllFlipRequest* m_request;
+};
