diff --git a/lsfg-vk-layer/src/paced-queue.hpp b/lsfg-vk-layer/src/paced-queue.hpp
new file mode 100644
index 0000000..007eabe
--- /dev/null
+++ b/lsfg-vk-layer/src/paced-queue.hpp
@@ -0,0 +1,200 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include "output-timing.hpp"
+#include <chrono>
+#include <condition_variable>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <thread>
+
+namespace lsfgvk::layer {
+using PresentWitness = void (*)(VkSwapchainKHR, uint64_t, int, uint32_t, VkExtent2D);
+
+// Recorded on the producer before publication. The consumer only submits these commands.
+struct DeferredCopy {
+    VkSemaphore acquired;
+    VkSemaphore recycled;
+    std::vector<VkCommandBuffer> commands;
+    std::vector<VkSemaphore> presentReady;
+};
+
+struct PendingImage {
+    std::shared_ptr<OutputTiming> timing;
+    VkSwapchainKHR chain;
+    VkSemaphore ready;
+    uint32_t image;
+    uint64_t frame;
+    int generated;
+    VkExtent2D extent;
+    bool observe;
+    PresentWitness witness;
+    VkSemaphore gpuProgress;
+    uint64_t requiredValue;
+    const DeferredCopy* copy = nullptr;
+    uint64_t recycleValue = 0;
+};
+
+class PacedQueue {
+    const vk::Vulkan& vk;
+    VkQueue queue;
+    PFN_vkQueueWaitIdle waitQueue;
+    std::mutex mutex;
+    std::mutex swapchainAccess;
+    std::condition_variable changed;
+    std::deque<PendingImage> images;
+    bool stopping = false;
+    bool busy = false;
+    VkResult error = VK_SUCCESS;
+    HANDLE timer;
+    int64_t frequency = 0;
+    int64_t deadline = 0;
+    unsigned rate;
+    std::thread thread;
+
+    static int64_t now() {
+        LARGE_INTEGER counter;
+        QueryPerformanceCounter(&counter);
+        return counter.QuadPart;
+    }
+
+    void pace() {
+        int64_t current = now();
+        if (deadline == 0 || current - deadline > frequency / (rate * 2)) deadline = current;
+        const int64_t spin = frequency / 5000;
+        if (timer && deadline > current + spin) {
+            LARGE_INTEGER due;
+            due.QuadPart = -((deadline - current - spin) * 10000000 / frequency);
+            if (due.QuadPart < 0 && SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE))
+                WaitForSingleObject(timer, INFINITE);
+        }
+        while (now() < deadline) YieldProcessor();
+        deadline += frequency / rate;
+    }
+
+    VkResult prepareDeferred(PendingImage& image) {
+        const auto& copy = *image.copy;
+        auto acquired = acquire(image.chain, 2000000000ULL, copy.acquired, VK_NULL_HANDLE, &image.image);
+        if (acquired != VK_SUCCESS && acquired != VK_SUBOPTIMAL_KHR) return acquired;
+        image.ready = copy.presentReady.at(image.image);
+        const VkSemaphore waits[]{copy.acquired, image.gpuProgress};
+        const uint64_t waitValues[]{0, image.requiredValue};
+        const VkPipelineStageFlags stages[]{VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT};
+        const VkSemaphore signals[]{image.ready, copy.recycled};
+        const uint64_t signalValues[]{0, image.recycleValue};
+        VkTimelineSemaphoreSubmitInfo timeline{VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO};
+        timeline.waitSemaphoreValueCount = 2;
+        timeline.pWaitSemaphoreValues = waitValues;
+        timeline.signalSemaphoreValueCount = 2;
+        timeline.pSignalSemaphoreValues = signalValues;
+        VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+        submit.pNext = &timeline;
+        submit.waitSemaphoreCount = 2;
+        submit.pWaitSemaphores = waits;
+        submit.pWaitDstStageMask = stages;
+        submit.commandBufferCount = 1;
+        submit.pCommandBuffers = &copy.commands.at(image.image);
+        submit.signalSemaphoreCount = 2;
+        submit.pSignalSemaphores = signals;
+        return vk.df().QueueSubmit(queue, 1, &submit, VK_NULL_HANDLE);
+    }
+
+    void run() {
+        SetThreadDescription(GetCurrentThread(), L"Saros optical present");
+        SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+        for (;;) {
+            std::unique_lock lock(mutex);
+            changed.wait(lock, [this] { return stopping || !images.empty(); });
+            if (images.empty()) return;
+            auto image = std::move(images.front());
+            images.pop_front();
+            busy = true;
+            lock.unlock();
+            VkSemaphoreWaitInfo wait{VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO};
+            wait.semaphoreCount=1;
+            wait.pSemaphores=&image.gpuProgress;
+            wait.pValues=&image.requiredValue;
+            // A binary semaphore remains in the WSI request for Vulkan's memory dependency.
+            auto ready=vk.df().WaitSemaphoresKHR(vk.dev(),&wait,UINT64_MAX);
+            if (ready==VK_SUCCESS) pace();
+            if (ready==VK_SUCCESS && image.copy) ready = prepareDeferred(image);
+            VkPresentInfoKHR present{VK_STRUCTURE_TYPE_PRESENT_INFO_KHR};
+            present.swapchainCount = 1;
+            present.pSwapchains = &image.chain;
+            present.pImageIndices = &image.image;
+            present.waitSemaphoreCount = 1;
+            present.pWaitSemaphores = &image.ready;
+            std::unique_lock access(swapchainAccess);
+            auto result = ready==VK_SUCCESS ? image.timing->Present(vk, queue, present, image.frame,
+                image.generated, image.extent, image.observe, false) : ready;
+            if (result == VK_SUCCESS || result == VK_SUBOPTIMAL_KHR)
+                image.witness(image.chain, image.frame, image.generated, image.image, image.extent);
+            access.unlock();
+            lock.lock();
+            if (result != VK_SUCCESS && (error == VK_SUCCESS || result < 0)) error = result;
+            busy = false;
+            changed.notify_all();
+        }
+    }
+public:
+    PacedQueue(const vk::Vulkan& device, VkQueue selected, unsigned hz) :
+        vk(device), queue(selected),
+        waitQueue(reinterpret_cast<PFN_vkQueueWaitIdle>(vk.fi().GetDeviceProcAddr(vk.dev(), "vkQueueWaitIdle"))),
+        timer(CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS)),
+        rate(hz) {
+        LARGE_INTEGER value;
+        QueryPerformanceFrequency(&value);
+        frequency = value.QuadPart;
+        thread = std::thread([this] { run(); });
+    }
+    ~PacedQueue() {
+        {
+            std::lock_guard lock(mutex);
+            stopping = true;
+        }
+        changed.notify_all();
+        thread.join();
+        if (timer) CloseHandle(timer);
+    }
+
+    VkResult acquire(VkSwapchainKHR chain, uint64_t timeout, VkSemaphore sem, VkFence fence, uint32_t* index) {
+        // Wait without the host lock between polls so that the output thread
+        // can release the earlier images while the producer waits for one.
+        const auto start = std::chrono::steady_clock::now();
+        for (;;) {
+            VkResult result;
+            {
+                std::lock_guard lock(swapchainAccess);
+                result = vk.df().AcquireNextImageKHR(vk.dev(), chain, 0, sem, fence, index);
+            }
+            if (result != VK_NOT_READY && result != VK_TIMEOUT) return result;
+            if (timeout == 0) return VK_NOT_READY;
+            const auto elapsed = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-start).count();
+            if (static_cast<uint64_t>(elapsed) >= timeout) return VK_TIMEOUT;
+            std::this_thread::sleep_for(std::chrono::microseconds(200));
+        }
+    }
+    VkResult submit(PendingImage image) {
+        std::lock_guard lock(mutex);
+        images.push_back(std::move(image));
+        changed.notify_one();
+        return error;
+    }
+
+    VkResult waitForRoom(size_t retained) {
+        std::unique_lock lock(mutex);
+        changed.wait(lock,[&] { return images.size()+size_t(busy)<=retained; });
+        return error;
+    }
+    VkResult drain(bool idle = true) {
+        std::unique_lock lock(mutex);
+        changed.wait(lock, [this] { return images.empty() && !busy; });
+        VkResult result = idle ? waitQueue(queue) : VK_SUCCESS;
+        if (result == VK_SUCCESS) result = error;
+        error = VK_SUCCESS;
+        return result;
+    }
+};
+}
