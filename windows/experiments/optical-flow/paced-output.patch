diff --git a/lsfg-vk-layer/src/output-timing.hpp b/lsfg-vk-layer/src/output-timing.hpp
new file mode 100644
index 0000000..41d9e4f
--- /dev/null
+++ b/lsfg-vk-layer/src/output-timing.hpp
@@ -0,0 +1,105 @@
+#pragma once
+#include <array>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#include <windows.h>
+#include "lsfg-vk-common/vulkan/vulkan.hpp"
+
+namespace lsfgvk::layer {
+class OutputTiming {
+    bool attempted = false;
+    bool enabled = false;
+    uint64_t timeDomainId = 0;
+    PFN_vkGetPastPresentationTimingEXT past = nullptr;
+    static FILE* Log() {
+        static FILE* file=[] {
+            char path[2048]{};
+            const DWORD length=GetEnvironmentVariableA("SAROS_WSI_TIMES",path,sizeof(path));
+            if (!length || length>=sizeof(path)) return static_cast<FILE*>(nullptr);
+            FILE* result=std::fopen(path,"wb");
+            if(result) std::setvbuf(result,nullptr,_IOFBF,65536);
+            return result;
+        }();
+        return file;
+    }
+    void Start(const vk::Vulkan& vk,VkSwapchainKHR chain) {
+        attempted=true;
+        if (!Log()) return;
+        auto get=vk.fi().GetDeviceProcAddr;
+        auto domains=reinterpret_cast<PFN_vkGetSwapchainTimeDomainPropertiesEXT>(get(vk.dev(),"vkGetSwapchainTimeDomainPropertiesEXT"));
+        auto size=reinterpret_cast<PFN_vkSetSwapchainPresentTimingQueueSizeEXT>(get(vk.dev(),"vkSetSwapchainPresentTimingQueueSizeEXT"));
+        past=reinterpret_cast<PFN_vkGetPastPresentationTimingEXT>(get(vk.dev(),"vkGetPastPresentationTimingEXT"));
+        if(!size || !past || !domains) return;
+        uint64_t domainCounter=0;
+        VkSwapchainTimeDomainPropertiesEXT list{VK_STRUCTURE_TYPE_SWAPCHAIN_TIME_DOMAIN_PROPERTIES_EXT};
+        if(domains(vk.dev(),chain,&list,&domainCounter)!=VK_SUCCESS || !list.timeDomainCount) return;
+        std::vector<VkTimeDomainKHR> types(list.timeDomainCount);
+        std::vector<uint64_t> ids(list.timeDomainCount);
+        list.pTimeDomains=types.data();list.pTimeDomainIds=ids.data();
+        if(domains(vk.dev(),chain,&list,&domainCounter)!=VK_SUCCESS || !list.timeDomainCount) return;
+        unsigned selected=0;
+        for(unsigned i=0;i<list.timeDomainCount;i++) if(types[i]==VK_TIME_DOMAIN_QUERY_PERFORMANCE_COUNTER_KHR) selected=i;
+        timeDomainId=ids[selected];
+        const auto result=size(vk.dev(),chain,256);
+        std::fprintf(Log(),"config,%llx,%d,%llu,%d\n",(unsigned long long)(uintptr_t)chain,int(types[selected]),(unsigned long long)timeDomainId,int(result));
+        std::fflush(Log());
+        enabled=result==VK_SUCCESS;
+    }
+    void Drain(const vk::Vulkan& vk,VkSwapchainKHR chain) {
+        std::array<VkPastPresentationTimingEXT,16> results{};
+        std::array<std::array<VkPresentStageTimeEXT,4>,16> stages{};
+        for (unsigned i=0;i<results.size();i++) {
+            results[i].sType=VK_STRUCTURE_TYPE_PAST_PRESENTATION_TIMING_EXT;
+            results[i].presentStageCount=stages[i].size();
+            results[i].pPresentStages=stages[i].data();
+        }
+        VkPastPresentationTimingInfoEXT query{VK_STRUCTURE_TYPE_PAST_PRESENTATION_TIMING_INFO_EXT};
+        query.swapchain=chain;
+        VkPastPresentationTimingPropertiesEXT batch{VK_STRUCTURE_TYPE_PAST_PRESENTATION_TIMING_PROPERTIES_EXT};
+        batch.presentationTimingCount=results.size();batch.pPresentationTimings=results.data();
+        const VkResult status=past(vk.dev(),&query,&batch);
+        if(status!=VK_SUCCESS && status!=VK_INCOMPLETE) return;
+        for(unsigned i=0;i<batch.presentationTimingCount;i++){
+            const auto& result=results[i];
+            for(unsigned j=0;j<result.presentStageCount;j++){
+                const auto& stamp=stages[i][j];
+                std::fprintf(Log(),"out,%llx,%llu,%u,%llu,%d,%llu,%u\n",(unsigned long long)(uintptr_t)chain,
+                    (unsigned long long)result.presentId,stamp.stage,(unsigned long long)stamp.time,int(result.timeDomain),
+                    (unsigned long long)result.timeDomainId,result.reportComplete);
+            }
+        }
+    }
+public:
+    VkResult Present(const vk::Vulkan& vk,VkQueue queue,VkPresentInfoKHR const& original,
+                     uint64_t frame,int generated,VkExtent2D extent,bool supported,bool relativeSupported) {
+        if(!supported) return vk.df().QueuePresentKHR(queue,&original);
+        auto chain=original.pSwapchains[0];
+        if(!attempted) Start(vk,chain);
+        if(!enabled) return vk.df().QueuePresentKHR(queue,&original);
+        Drain(vk,chain);
+        static std::atomic<uint64_t> serial{0};
+        const uint64_t id=++serial;
+        VkPresentTimingInfoEXT request{VK_STRUCTURE_TYPE_PRESENT_TIMING_INFO_EXT};
