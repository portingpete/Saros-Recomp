diff --git a/core/kyty/graphics/shader/SpirvLoopFuel.h b/core/kyty/graphics/shader/SpirvLoopFuel.h
new file mode 100644
--- /dev/null
+++ b/core/kyty/graphics/shader/SpirvLoopFuel.h
@@ -0,0 +1,319 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <unordered_map>
+#include <vector>
+
+namespace Libs::Graphics::SpirvLoopFuel {
+
+inline uint32_t Budget() noexcept {
+	static const uint32_t budget = [] {
+		const char* value = std::getenv("KYTY_LOOP_FUEL");
+		if (value == nullptr) return uint32_t {1} << 26u;
+		return static_cast<uint32_t>(std::strtoul(value, nullptr, 0));
+	}();
+	return budget;
+}
+
+inline uint32_t SmallestLoop() noexcept {
+	static const uint32_t smallest = [] {
+		const char* value = std::getenv("KYTY_LOOP_FUEL_MIN");
+		if (value == nullptr) return uint32_t {0};
+		return static_cast<uint32_t>(std::strtoul(value, nullptr, 0));
+	}();
+	return smallest;
+}
+
+inline bool GuardsRayWalks() noexcept {
+	static const bool guards = [] {
+		const char* value = std::getenv("KYTY_LOOP_FUEL_RAY_WALKS");
+		return value != nullptr && value[0] == '1';
+	}();
+	return guards;
+}
+
+inline uint64_t Stamp() noexcept {
+	if (Budget() == 0) return 0;
+	return (uint64_t {Budget()} * 0x9e3779b97f4a7c15ull) ^ (uint64_t {SmallestLoop()} << 40u) ^
+	       (GuardsRayWalks() ? 0ull : 0x52a7c0deull << 8u);
+}
+
+inline bool Enabled() noexcept {
+	return Budget() != 0;
+}
+
+inline bool Apply(std::vector<uint32_t>& words) {
+	constexpr uint32_t OpEntryPoint       = 15;
+	constexpr uint32_t OpTypeBool         = 20;
+	constexpr uint32_t OpTypeInt          = 21;
+	constexpr uint32_t OpTypeVoid         = 19;
+	constexpr uint32_t OpTypePointer      = 32;
+	constexpr uint32_t OpConstant         = 43;
+	constexpr uint32_t OpConstantNull     = 46;
+	constexpr uint32_t OpFunction         = 54;
+	constexpr uint32_t OpVariable         = 59;
+	constexpr uint32_t OpLoad             = 61;
+	constexpr uint32_t OpStore            = 62;
+	constexpr uint32_t OpISub             = 130;
+	constexpr uint32_t OpSelect           = 169;
+	constexpr uint32_t OpULessThan        = 176;
+	constexpr uint32_t OpPhi              = 245;
+	constexpr uint32_t OpLoopMerge        = 246;
+	constexpr uint32_t OpSelectionMerge   = 247;
+	constexpr uint32_t OpLabel            = 248;
+	constexpr uint32_t OpBranch           = 249;
+	constexpr uint32_t OpBranchConditional = 250;
+	constexpr uint32_t OpReturn           = 253;
+	constexpr uint32_t OpReturnValue      = 254;
+	constexpr uint32_t OpGroupFirst       = 333;
+	constexpr uint32_t OpGroupLast        = 366;
+	constexpr uint32_t OpRayQueryProceed  = 4477;
+	constexpr uint32_t StoragePrivate     = 6;
+
+	if (!Enabled() || words.size() < 5) return false;
+
+	struct Instruction {
+		size_t   at;
+		uint32_t opcode;
+		uint32_t count;
+	};
+	std::vector<Instruction> instructions;
+	for (size_t at = 5; at < words.size();) {
+		const uint32_t count = words[at] >> 16u;
+		if (count == 0 || at + count > words.size()) return false;
+		instructions.push_back({at, words[at] & 0xffffu, count});
+		at += count;
+	}
+
+	uint32_t uint_type    = 0;
+	uint32_t bool_type    = 0;
+	uint32_t pointer_type = 0;
+	size_t   first_function = instructions.size();
+	std::unordered_map<uint32_t, bool> void_types;
+	for (size_t i = 0; i < instructions.size(); ++i) {
+		const auto& in = instructions[i];
+		const auto* w  = words.data() + in.at;
+		if (in.opcode == OpTypeInt && in.count == 4 && w[2] == 32 && w[3] == 0 && uint_type == 0) uint_type = w[1];
+		if (in.opcode == OpTypeBool && bool_type == 0) bool_type = w[1];
+		if (in.opcode == OpTypeVoid) void_types[w[1]] = true;
+		if (in.opcode == OpFunction && first_function == instructions.size()) first_function = i;
+	}
+	if (first_function == instructions.size()) return false;
+	for (size_t i = 0; i < first_function; ++i) {
+		const auto& in = instructions[i];
+		const auto* w  = words.data() + in.at;
+		if (in.opcode == OpTypePointer && w[2] == StoragePrivate && uint_type != 0 && w[3] == uint_type) pointer_type = w[1];
+	}
+
+	struct Edge {
+		uint32_t target;
+		uint32_t check;
+		uint32_t leave;
+		uint32_t join;
+		uint32_t loaded;
+		uint32_t spent;
+		uint32_t left;
+		uint32_t kept;
+	};
+	struct Loop {
+		size_t            terminator;
+		uint32_t          header;
+		uint32_t          cost;
+		uint32_t          return_type;
+		std::vector<Edge> edges;
+		size_t            first = 0;
+		size_t            last  = 0;
+		bool              walk  = false;
+		bool              spare = false;
+	};
+	std::vector<Loop> loops;
+	uint32_t          bound = words[3];
+	const auto        fresh = [&bound] { return bound++; };
+
+	std::unordered_map<uint32_t, size_t> label_index;
+	for (size_t i = first_function; i < instructions.size(); ++i) {
+		if (instructions[i].opcode == OpLabel) label_index[words[instructions[i].at + 1]] = i;
+	}
+	uint32_t return_type = 0;
+	uint32_t block       = 0;
+	size_t   block_index = 0;
+	for (size_t i = first_function; i + 1 < instructions.size(); ++i) {
+		const auto& in = instructions[i];
+		const auto* w  = words.data() + in.at;
+		if (in.opcode == OpFunction) return_type = w[1];
+		if (in.opcode == OpLabel) {
+			block       = w[1];
+			block_index = i;
+		}
+		if (in.opcode != OpLoopMerge) continue;
+		const uint32_t merge    = w[1];
+		const uint32_t carry_on = w[2];
+		if (carry_on == block) continue;
+		const auto& next = instructions[i + 1];
+		const auto* t    = words.data() + next.at;
+		std::vector<uint32_t> targets;
+		if (next.opcode == OpBranch) {
+			targets.push_back(t[1]);
+		} else if (next.opcode == OpBranchConditional) {
+			if (t[2] == t[3]) continue;
+			if (t[2] != merge) targets.push_back(t[2]);
+			if (t[3] != merge) targets.push_back(t[3]);
+		} else {
+			continue;
+		}
+		if (targets.empty() || std::ranges::find(targets, block) != targets.end()) continue;
+		const auto merge_at = label_index.find(merge);
+		const auto size     = merge_at != label_index.end() && merge_at->second > block_index
+		                          ? static_cast<uint32_t>(merge_at->second - block_index)
+		                          : 64u;
+		if (size < SmallestLoop()) continue;
+		Loop loop {.terminator = i + 1, .header = block, .cost = std::max(size, 8u), .return_type = return_type};
+		if (merge_at != label_index.end() && merge_at->second > block_index) {
+			loop.first = block_index;
+			loop.last  = merge_at->second;
+		}
+		for (const auto target: targets) {
+			loop.edges.push_back({target, fresh(), fresh(), fresh(), fresh(), fresh(), fresh(), fresh()});
+		}
+		loops.push_back(std::move(loop));
+	}
+	if (!GuardsRayWalks()) {
+		for (size_t i = first_function; i < instructions.size(); ++i) {
+			if (instructions[i].opcode != OpRayQueryProceed) continue;
+			Loop* innermost = nullptr;
+			for (auto& loop: loops) {
+				if (loop.first < i && i < loop.last && (innermost == nullptr || loop.first > innermost->first)) innermost = &loop;
+			}
+			if (innermost != nullptr) innermost->walk = true;
+		}
+		for (auto& loop: loops) {
+			if (loop.walk || loop.last == 0) continue;
+			bool inside = false;
+			for (const auto& outer: loops) {
+				inside = inside || (outer.walk && outer.first < loop.first && loop.last <= outer.last);
+			}
+			if (!inside) continue;
+			loop.spare = true;
+			for (size_t i = loop.first; i < loop.last; ++i) {
+				if (instructions[i].opcode >= OpGroupFirst && instructions[i].opcode <= OpGroupLast) loop.spare = false;
+			}
+		}
+		std::erase_if(loops, [](const Loop& loop) { return loop.walk || loop.spare; });
+	}
+	if (loops.empty()) return false;
+
+	std::vector<uint32_t> globals;
+	const auto emit = [](std::vector<uint32_t>& out, uint32_t opcode, std::initializer_list<uint32_t> operands) {
+		out.push_back((static_cast<uint32_t>(operands.size() + 1) << 16u) | opcode);
+		out.insert(out.end(), operands);
+	};
+	if (bool_type == 0) {
+		bool_type = fresh();
+		emit(globals, OpTypeBool, {bool_type});
+	}
+	if (uint_type == 0) {
+		uint_type = fresh();
+		emit(globals, OpTypeInt, {uint_type, 32, 0});
+	}
+	if (pointer_type == 0) {
+		pointer_type = fresh();
+		emit(globals, OpTypePointer, {pointer_type, StoragePrivate, uint_type});
+	}
+	const uint32_t budget = fresh();
+	const uint32_t zero   = fresh();
+	const uint32_t fuel   = fresh();
+	emit(globals, OpConstant, {uint_type, budget, Budget()});
+	emit(globals, OpConstant, {uint_type, zero, 0});
+	std::unordered_map<uint32_t, uint32_t> costs;
+	std::unordered_map<uint32_t, uint32_t> nulls;
+	for (const auto& loop: loops) {
+		if (!costs.contains(loop.cost)) {
+			const auto id = fresh();
+			costs[loop.cost] = id;
+			emit(globals, OpConstant, {uint_type, id, loop.cost});
+		}
+		if (!void_types.contains(loop.return_type) && !nulls.contains(loop.return_type)) {
+			const auto id = fresh();
+			nulls[loop.return_type] = id;
+			emit(globals, OpConstantNull, {loop.return_type, id});
+		}
+	}
+	emit(globals, OpVariable, {pointer_type, fuel, StoragePrivate, budget});
+
+	std::unordered_map<size_t, const Loop*> by_terminator;
+	std::unordered_map<uint64_t, uint32_t>  phi_parents;
+	for (const auto& loop: loops) {
+		by_terminator[loop.terminator] = &loop;
+		for (const auto& edge: loop.edges) {
+			phi_parents[(uint64_t {edge.target} << 32u) | loop.header] = edge.join;
+		}
+	}
+
+	const bool            interface_all = words[1] >= 0x00010400u;
+	std::vector<uint32_t> out(words.begin(), words.begin() + 5);
+	out.reserve(words.size() + globals.size() + loops.size() * 40);
+	block = 0;
+	for (size_t i = 0; i < instructions.size(); ++i) {
+		const auto& in = instructions[i];
+		const auto* w  = words.data() + in.at;
+		if (i == first_function) out.insert(out.end(), globals.begin(), globals.end());
+		if (in.opcode == OpEntryPoint && interface_all) {
+			out.push_back(((in.count + 1) << 16u) | OpEntryPoint);
+			out.insert(out.end(), w + 1, w + in.count);
+			out.push_back(fuel);
+			continue;
+		}
+		if (in.opcode == OpLabel) block = w[1];
+		if (in.opcode == OpPhi) {
+			const auto start = out.size();
+			out.insert(out.end(), w, w + in.count);
+			for (uint32_t operand = 4; operand < in.count; operand += 2) {
+				const auto found = phi_parents.find((uint64_t {block} << 32u) | w[operand]);
+				if (found != phi_parents.end()) out[start + operand] = found->second;
+			}
+			continue;
+		}
+		const auto found = by_terminator.find(i);
+		if (found == by_terminator.end()) {
+			out.insert(out.end(), w, w + in.count);
+			continue;
+		}
+		const auto& loop  = *found->second;
+		const auto  start = out.size();
+		out.insert(out.end(), w, w + in.count);
+		for (const auto& edge: loop.edges) {
+			if (in.opcode == OpBranch) {
+				out[start + 1] = edge.check;
+			} else {
+				if (w[2] == edge.target) out[start + 2] = edge.check;
+				if (w[3] == edge.target) out[start + 3] = edge.check;
+			}
+		}
+		for (const auto& edge: loop.edges) {
+			const auto cost = costs[loop.cost];
+			emit(out, OpLabel, {edge.check});
+			emit(out, OpLoad, {uint_type, edge.loaded, fuel});
+			emit(out, OpULessThan, {bool_type, edge.spent, edge.loaded, cost});
+			emit(out, OpISub, {uint_type, edge.left, edge.loaded, cost});
+			emit(out, OpSelect, {uint_type, edge.kept, edge.spent, zero, edge.left});
+			emit(out, OpStore, {fuel, edge.kept});
+			emit(out, OpSelectionMerge, {edge.join, 0});
+			emit(out, OpBranchConditional, {edge.spent, edge.leave, edge.join});
+			emit(out, OpLabel, {edge.leave});
+			if (void_types.contains(loop.return_type)) {
+				emit(out, OpReturn, {});
+			} else {
+				emit(out, OpReturnValue, {nulls[loop.return_type]});
+			}
+			emit(out, OpLabel, {edge.join});
+			emit(out, OpBranch, {edge.target});
+		}
+	}
+	out[3] = bound;
+	words  = std::move(out);
+	return true;
+}
+
+}
