diff --git a/core/kyty/graphics/host_gpu/renderer/protectionLane.h b/core/kyty/graphics/host_gpu/renderer/protectionLane.h
new file mode 100644
--- /dev/null
+++ b/core/kyty/graphics/host_gpu/renderer/protectionLane.h
@@ -0,0 +1,43 @@
+#pragma once
+#include "graphics/host_gpu/renderer/hostCopyQueue.h"
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <mutex>
+namespace Libs::Graphics::ProtectionLane {
+inline std::mutex mutex;
+inline std::map<HostCopyQueue*,std::unique_ptr<HostCopyQueue>> lanes;
+inline bool enabled() {
+    static const bool value=[] {const char* text=std::getenv("SAROS_PARALLEL_PROTECTION");return text && *text=='1';}();
+    return value;
+}
+inline void open(HostCopyQueue* copies) {
+    if(!copies || !enabled())return;
+    std::lock_guard lock(mutex);
+    lanes.emplace(copies,std::make_unique<HostCopyQueue>());
+}
+inline HostCopyQueue* find(HostCopyQueue* copies) {
+    if(!copies || !enabled())return nullptr;
+    std::lock_guard lock(mutex);
+    const auto it=lanes.find(copies);
+    return it==lanes.end()?nullptr:it->second.get();
+}
+inline uint64_t publish(HostCopyQueue& copies,HostCopyQueue& protections) {
+    const auto ticket=protections.Flush();
+    // All later staging reads and submission tickets follow this join in the copy FIFO.
+    copies.Call([](void* lane,uint64_t required,uint64_t){static_cast<HostCopyQueue*>(lane)->WaitFor(required);},&protections,ticket,0);
+    (void)copies.Flush();
+    return ticket;
+}
+inline void drain(HostCopyQueue& copies,HostCopyQueue& protections) {
+    protections.WaitFor(protections.Flush());
+    copies.WaitFor(copies.Flush());
+}
+inline void close(HostCopyQueue* copies) {
+    if(auto* protections=find(copies)) {
+        drain(*copies,*protections);
+        std::lock_guard lock(mutex);
+        lanes.erase(copies);
+    }
+}
+}
