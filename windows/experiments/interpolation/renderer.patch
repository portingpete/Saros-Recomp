diff --git a/core/kyty/graphics/host_gpu/bdaSubmissionSync.h b/core/kyty/graphics/host_gpu/bdaSubmissionSync.h
new file mode 100644
--- /dev/null
+++ b/core/kyty/graphics/host_gpu/bdaSubmissionSync.h
@@ -0,0 +1,190 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+namespace Libs::Graphics::BdaSubmissionSync {
+
+inline constexpr uint64_t PageSize = 4096;
+
+inline uint64_t NowNs() noexcept {
+	return static_cast<uint64_t>(
+	    std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+inline bool Enabled() noexcept {
+	static const bool on = [] {
+		const char* value = std::getenv("KYTY_BDA_SUBMISSION_SYNC");
+		return value == nullptr || value[0] != '0';
+	}();
+	return on;
+}
+
+struct Enqueued {
+	std::atomic<const void*> commands {nullptr};
+	std::atomic<uint64_t>    ns {0};
+};
+inline std::array<Enqueued, 256> enqueued;
+inline std::atomic<uint32_t>     enqueued_next {0};
+
+inline void NoteEnqueued(const void* commands) noexcept {
+	auto& entry = enqueued[enqueued_next.fetch_add(1, std::memory_order_relaxed) % enqueued.size()];
+	entry.commands.store(nullptr, std::memory_order_release);
+	entry.ns.store(NowNs(), std::memory_order_release);
+	entry.commands.store(commands, std::memory_order_release);
+}
+
+inline uint64_t EnqueuedTime(const void* commands) noexcept {
+	const auto next = enqueued_next.load(std::memory_order_acquire);
+	for (uint32_t back = 1; back <= enqueued.size(); back++) {
+		const auto& entry = enqueued[(next - back) % enqueued.size()];
+		if (entry.commands.load(std::memory_order_acquire) == commands) {
+			return entry.ns.load(std::memory_order_acquire);
+		}
+	}
+	return 0;
+}
+
+struct ProcessorTime {
+	std::atomic<const void*> processor {nullptr};
+	std::atomic<uint64_t>    ns {0};
+};
+inline std::array<ProcessorTime, 32> processors;
+
+inline std::atomic<uint64_t>* InputTime(const void* processor) noexcept {
+	if (processor == nullptr) return nullptr;
+	for (auto& entry: processors) {
+		const void* owner = entry.processor.load(std::memory_order_acquire);
+		if (owner == processor) return &entry.ns;
+		if (owner == nullptr) {
+			const void* expected = nullptr;
+			if (entry.processor.compare_exchange_strong(expected, processor, std::memory_order_acq_rel) ||
+			    expected == processor) {
+				return &entry.ns;
+			}
+		}
+	}
+	return nullptr;
+}
+
+inline void SetInputTime(const void* processor, uint64_t ns) noexcept {
+	if (auto* time = InputTime(processor); time != nullptr) time->store(ns, std::memory_order_release);
+}
+
+inline std::array<std::atomic<uint64_t>, 16384> operation_times;
+
+inline void NoteOperation(uint64_t sequence, const void* processor) noexcept {
+	const auto* time = InputTime(processor);
+	operation_times[sequence % operation_times.size()].store(time != nullptr ? time->load(std::memory_order_acquire) : 0,
+	                                                         std::memory_order_release);
+}
+
+inline uint64_t current_input_time = 0;
+inline uint64_t last_pass_ns       = 0;
+
+inline void BeginOperation(uint64_t sequence) noexcept {
+	current_input_time = sequence != 0 ? operation_times[sequence % operation_times.size()].load(std::memory_order_acquire) : 0;
+}
+
+inline std::mutex                                 written_mutex;
+inline std::vector<std::pair<uint64_t, uint64_t>> written_ranges;
+inline std::unordered_set<uint64_t>               written_pages;
+inline uint64_t                                   written_last_page = UINT64_MAX;
+inline bool                                       written_overflow  = false;
+
+inline void NoteEmulatorWrite(uint64_t vaddr, uint64_t size) noexcept {
+	if (size == 0 || !Enabled()) return;
+	const auto first = vaddr & ~(PageSize - 1);
+	const auto last  = (vaddr + size + PageSize - 1) & ~(PageSize - 1);
+	std::lock_guard lock(written_mutex);
+	if (written_overflow) return;
+	if (last - first > 16 * PageSize) {
+		if (written_ranges.size() >= 256) {
+			written_overflow = true;
+			return;
+		}
+		written_ranges.emplace_back(first, last - first);
+		return;
+	}
+	for (auto page = first; page < last; page += PageSize) {
+		if (page == written_last_page) continue;
+		written_last_page = page;
+		if (written_pages.size() >= 8192) {
+			written_overflow = true;
+			return;
+		}
+		written_pages.insert(page);
+	}
+}
+
+inline bool TakeWritten(std::vector<std::pair<uint64_t, uint64_t>>& out) {
+	std::lock_guard lock(written_mutex);
+	out.insert(out.end(), written_ranges.begin(), written_ranges.end());
+	written_ranges.clear();
+	for (const auto page: written_pages) out.emplace_back(page, PageSize);
+	written_pages.clear();
+	written_last_page = UINT64_MAX;
+	return std::exchange(written_overflow, false);
+}
+
+inline const std::vector<std::pair<uint64_t, uint64_t>>* stale_only = nullptr;
+
+inline std::vector<std::pair<uint64_t, uint64_t>> registered;
+inline bool                                       registered_lost = false;
+
+inline void NoteRegistered(uint64_t address, uint64_t size) {
+	if (!Enabled()) return;
+	if (registered.size() < 256) {
+		registered.emplace_back(address, size);
+	} else {
+		registered_lost = true;
+	}
+}
+
+inline bool TakeRegistered(std::vector<std::pair<uint64_t, uint64_t>>& out) {
+	out.insert(out.end(), registered.begin(), registered.end());
+	registered.clear();
+	return std::exchange(registered_lost, false);
+}
+
+inline std::atomic<uint64_t> skipped {0};
+inline std::atomic<uint64_t> synchronized_ranges {0};
+inline std::atomic<uint64_t> passes_later {0};
+inline std::atomic<uint64_t> passes_lost {0};
+inline std::atomic<uint64_t> passes_off {0};
+inline std::atomic<int64_t>  last_line {0};
+
+inline void Log() {
+	const auto now  = static_cast<int64_t>(NowNs());
+	auto       last = last_line.load(std::memory_order_relaxed);
+	if (last == 0) {
+		last_line.compare_exchange_strong(last, now, std::memory_order_relaxed);
+		return;
+	}
+	if (now - last < 10'000'000'000 || !last_line.compare_exchange_strong(last, now, std::memory_order_relaxed)) return;
+	const auto skips  = skipped.exchange(0, std::memory_order_relaxed);
+	const auto ranges = synchronized_ranges.exchange(0, std::memory_order_relaxed);
+	const auto later  = passes_later.exchange(0, std::memory_order_relaxed);
+	const auto lost   = passes_lost.exchange(0, std::memory_order_relaxed);
+	const auto off    = passes_off.exchange(0, std::memory_order_relaxed);
+	if (skips + later + lost + off == 0) return;
+	std::fprintf(stderr,
+	             "[kyty-bda-sync] summary of the last %.0f s: %llu full passes skipped for dispatches submitted before the "
+	             "last pass (%llu written or registered ranges synchronized instead); %llu full passes run: %llu for a "
+	             "dispatch submitted after the last pass, %llu after more writes or registrations than are listed, %llu "
+	             "with the skip switched off\n",
+	             static_cast<double>(now - last) / 1e9, static_cast<unsigned long long>(skips),
+	             static_cast<unsigned long long>(ranges), static_cast<unsigned long long>(later + lost + off),
+	             static_cast<unsigned long long>(later), static_cast<unsigned long long>(lost),
+	             static_cast<unsigned long long>(off));
+}
+
+}
