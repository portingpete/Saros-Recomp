+	uint8_t  opq_reason = 0;
+	uint64_t opq_seq    = 0;
+	for (uint64_t i = total; i-- > first;) {
+		const auto& entry = m_resolved_writes[i % ResolvedWriteCapacity];
+		if (entry.sequence <= executed) {
+			break;
+		}
+		if (entry.sequence >= before_seq) {
+			continue;
+		}
+		if (entry.begin < end && begin < entry.end) {
+			if (entry.reason == 0) {
+				if (out_hit_reason) *out_hit_reason = 0;
+				if (out_hit_seq) *out_hit_seq = entry.sequence;
+				if (out_only_opaque) *out_only_opaque = false;
+				return true;
+			}
+			if (!saw_opaque) {
+				saw_opaque = true;
+				opq_reason = entry.reason;
