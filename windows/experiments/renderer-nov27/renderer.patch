+enum Kind : uint16_t {
+	EmulatorWrite = 1, // the renderer wrote these guest bytes; value = the first bytes after the write
+	GpuMarked,         // the range was marked as written by the GPU (bound buffer or copy target)
+	GpuNoted,          // a device address writer was found to have written the range
+	Shared,            // a buffer became guest memory
+	Unshared,          // a shared buffer became a copy again
+	Unmapped,          // the guest unmapped the range
+	Import,            // a chunk of the backing view was imported; address = view offset
+	GpuIntoShared,     // the renderer recorded a GPU write into a shared buffer; value = site
+	NotedIntoShared,   // a device address writer wrote a shared buffer
+	Fault,             // a guest thread faulted on a wild address; address = rip, value = fault address
+	Readback,          // GPU bytes were brought back to these guest bytes (the write itself is an EmulatorWrite)
+	WriteAfterUnshare, // a write of 4 KiB or more into a range that stopped being shared a moment ago;
+	                   // value = bytes it changes, and in the high half how many of those become zero
+	WriteSample,       // the same count for one in sixteen of the other large writes
+	GuestFault,        // a guest thread took a page fault the renderer resolved; address = rip, value = the
+	                   // faulting address, size = 1 for a write.  A fault on a guest thread is delivered on that
+	                   // thread's stack, below RSP, where a leaf function of the guest keeps values if it was
+	                   // not converted to use a frame: the faults of a thread just before it dies are evidence.
