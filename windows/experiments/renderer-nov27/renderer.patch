+constexpr size_t MaxTrackedComputeHazardRanges = 128u;
+constexpr uint64_t ImageHazardTagBit           = 1ull << 63u;
+
+void PushAlignedHazardRange(std::vector<ComputeHazardRangeLocal>& out, uint64_t addr, uint64_t size) {
+	if (addr == 0 || size == 0) {
+		return;
+	}
+	const uint64_t b = addr & ~63ull;
+	const uint64_t e = (addr + size + 63ull) & ~63ull;
+	if (b < e) {
+		out.push_back({b, e});
+	}
