+// One history per address and value: two consumers that read the same bytes at different points of a
+// frame each expect their own value, and each value is steady from frame to frame.
+BufferCache::GpuPeek* BufferCache::FindGpuPeek(uint64_t address, uint32_t size, const void* bytes, bool create) {
+	GpuPeek* oldest = nullptr;
+	for (auto& peek: m_gpu_peeks) {
+		if (peek.address == address && peek.size == size && std::memcmp(peek.bytes.data(), bytes, size) == 0) {
+			peek.used = ++m_gpu_peek_uses;
+			return &peek;
+		}
+		if (!peek.pending && (oldest == nullptr || peek.used < oldest->used)) oldest = &peek;
+	}
+	if (!create) return nullptr;
+	if (m_gpu_peeks.size() < MaxGpuPeeks) {
+		m_gpu_peeks.reserve(MaxGpuPeeks);
+		oldest = &m_gpu_peeks.emplace_back();
+	}
+	if (oldest == nullptr) return nullptr;
+	*oldest = GpuPeek {.address = address, .used = ++m_gpu_peek_uses, .size = size};
+	std::memcpy(oldest->bytes.data(), bytes, size);
+	return oldest;
+}
+
+bool BufferCache::ObserveGpuPeek(GpuPeek& peek, const void* bytes) {
+	if (std::memcmp(peek.bytes.data(), bytes, peek.size) == 0) {
+		peek.confirmed++;
+		return true;
+	}
+	std::memcpy(peek.bytes.data(), bytes, peek.size);
+	peek.confirmed = 0;
+	peek.failures  = std::min<uint32_t>(peek.failures + 1, 8);
+	return false;
+}
