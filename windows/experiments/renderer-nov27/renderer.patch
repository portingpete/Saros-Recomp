+void BeginGuardedDispatch(const CommandRecorder& command, bool guarded, vk::Buffer predicate, uint64_t offset) {
+	if (!guarded) return;
+	vk::ConditionalRenderingBeginInfoEXT condition {};
+	condition.buffer = predicate;
+	condition.offset = offset;
+	command.beginConditionalRenderingEXT(&condition);
