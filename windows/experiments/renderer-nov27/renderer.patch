+#ifndef EMULATOR_SRC_COMMON_FRAMECENSUS_H_
+#define EMULATOR_SRC_COMMON_FRAMECENSUS_H_
+
+// Where the renderer's threads spend a frame. KYTY_FRAME_CENSUS=1 switches it on; a scope then costs
+// two clock reads, and when it is off one predictable branch. Times are inclusive: a site entered
+// inside another one is counted in both. The summary is one line per site every ten seconds,
+// normalised per completed guest frame, so two runs can be compared at different frame rates.
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+namespace Common::FrameCensus {
+
+enum Site : uint32_t {
+	ExecIdle,          // execution thread: no operation queued (starved by the command processor or resolver)
+	ExecUrgent,        // execution thread: commands other threads sent it (readbacks, write backs, unmaps)
+	ExecDraw,
+	ExecDispatch,
+	ExecCallback,
+	ExecCopyDrain,     // execution thread: waiting for the host copy worker before a callback
+	ExecGpuWait,       // execution thread: waiting for a submitted tick (CommandScheduler::Wait / Finish)
+	ExecPriorityWait,  // execution thread: waiting for deferred operations of earlier ticks
+	BdaFullPass,
+	BdaStalePass,
+	BdaRegionPass,
+	BdaFootprint,      // exact per-shader device address synchronisation
+	CpProcess,         // command processor: decoding guest command buffers
+	CpBlocked,         // command processor: every queue waits for a label
+	CpWaitExec,        // command processor: waiting for the execution thread
+	ResolveIdle,
+	ResolveWork,
+	RecordIdle,
+	RecordReplay,      // recording thread: replaying commands into Vulkan
+	RecordCopyWait,    // recording thread: waiting for host copies before a submit
+	RecordSubmit,      // recording thread: vkQueueSubmit
+	GuestFrameReady,   // guest: suspend point waiting for the previous frame on the GPU
+	GuestSuspendReady,
+	ResolvePush,       // resolver: the execution thread's queue is full
+	ExecEager,         // execution thread: scheduling and applying eager readbacks
+	WorkerCopy,        // copy worker: memory copies into staging
+	WorkerCall,        // copy worker: calls (waiting for the protection lane, or protections without a lane)
+	LaneProtect,       // protection lane: page protections
+	CpFetchSync,       // command processor: PFP_SYNC_ME, waiting for the execution thread before the next fetch
+	CpFetchRead,       // command processor: reading command memory the GPU wrote
+	Count
+};
+
+inline constexpr const char* Names[Count] = {
+    "exec idle",      "exec urgent",     "exec draw",        "exec dispatch",    "exec callback",   "exec copy drain",
+    "exec gpu wait",  "exec prio wait",  "bda full pass",    "bda stale pass",   "bda region pass", "bda footprint",
+    "cp process",     "cp blocked",      "cp wait exec",     "resolve idle",     "resolve work",    "record idle",
+    "record replay",  "record copy wait", "record submit",   "guest frame wait", "guest susp wait", "resolve push",
+    "exec eager",     "worker copies",   "worker calls",     "lane protects",    "cp fetch sync",   "cp fetch read",
+};
+
+struct Slot {
+	std::atomic<uint64_t> count {0};
+	std::atomic<uint64_t> ns {0};
+	std::atomic<uint64_t> worst {0};
+};
+
+inline std::array<Slot, Count> g_slots {};
+inline std::atomic<uint64_t>   g_frames {0};
+inline std::atomic<uint64_t>   g_last_report {0};
+inline std::atomic<uint64_t>   g_submits {0};
+inline std::atomic<uint64_t>   g_empty_submits {0};
+inline std::atomic<uint64_t>   g_gpu_idle_submits {0};
+inline std::atomic<uint64_t>   g_ops {0};
+
+// What the execution thread was doing when it took a page fault of its own: a tag set by the code
+// around the access, and per tag the faults and the time their handling took.
+inline thread_local const char* t_site = "untagged";
+
+struct SiteTag {
+	explicit SiteTag(const char* site) noexcept: previous(t_site) { t_site = site; }
+	~SiteTag() { t_site = previous; }
+	SiteTag(const SiteTag&)            = delete;
+	SiteTag& operator=(const SiteTag&) = delete;
+	const char* previous;
+};
+
+struct FaultSlot {
+	std::atomic<const char*> name {nullptr};
+	std::atomic<uint64_t>    reads {0};
+	std::atomic<uint64_t>    writes {0};
+	std::atomic<uint64_t>    ns {0};
+};
+
+inline std::array<FaultSlot, 24> g_fault_slots {};
+
+inline void NoteFault(bool write, uint64_t ns) noexcept {
+	const char* site = t_site;
+	for (auto& slot: g_fault_slots) {
+		const char* name = slot.name.load(std::memory_order_acquire);
+		if (name == nullptr) {
+			const char* expected = nullptr;
+			if (slot.name.compare_exchange_strong(expected, site, std::memory_order_acq_rel)) {
+				name = site;
+			} else {
+				name = expected;
+			}
+		}
+		if (name == site) {
+			(write ? slot.writes : slot.reads).fetch_add(1, std::memory_order_relaxed);
+			slot.ns.fetch_add(ns, std::memory_order_relaxed);
+			return;
+		}
+	}
+}
+
+// Page faults by the thread that took them: how many, and how long their handling held the thread.
+struct ThreadFaults {
+	char                  name[48] {};
+	std::atomic<uint64_t> reads {0};
+	std::atomic<uint64_t> writes {0};
+	std::atomic<uint64_t> read_ns {0};
+	std::atomic<uint64_t> write_ns {0};
+	std::atomic<uint64_t> worst_ns {0};
+};
+
+inline std::array<ThreadFaults, 192> g_thread_faults {};
+inline std::atomic<uint32_t>         g_thread_fault_slots {0};
+inline thread_local ThreadFaults*    t_thread_faults = nullptr;
+
+// The slot of the calling thread; name_of fills the name the first time.
+template <class NameOf>
+inline ThreadFaults* ThreadFaultSlot(NameOf&& name_of) noexcept {
+	if (t_thread_faults == nullptr) {
+		const auto index = g_thread_fault_slots.fetch_add(1, std::memory_order_relaxed);
+		if (index >= g_thread_faults.size()) {
+			return nullptr;
+		}
+		t_thread_faults = &g_thread_faults[index];
+		name_of(t_thread_faults->name, sizeof(t_thread_faults->name));
+	}
+	return t_thread_faults;
+}
+
+// Waits of the execution thread for a tick: the part until the recorder had submitted the tick, and the
+// part the GPU took after that.
+inline std::array<std::atomic<uint64_t>, 4096> g_submit_ns {};
+inline std::atomic<uint64_t>                   g_wait_count {0};
+inline std::atomic<uint64_t>                   g_wait_record_ns {0};
+inline std::atomic<uint64_t>                   g_wait_gpu_ns {0};
+inline std::atomic<uint64_t>                   g_wait_ticks_ahead {0};
+inline std::atomic<uint64_t>                   g_wait_unsubmitted {0};
+
+inline std::atomic<uint64_t> g_worker_bytes {0};
+
+inline bool Enabled() noexcept {
+	static const bool on = [] {
+		const char* value = std::getenv("KYTY_FRAME_CENSUS");
+		return value != nullptr && value[0] == '1';
+	}();
+	return on;
+}
+
+inline uint64_t Now() noexcept {
+	return static_cast<uint64_t>(
+	    std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+inline void Add(Site site, uint64_t ns) noexcept {
+	auto& slot = g_slots[site];
+	slot.count.fetch_add(1, std::memory_order_relaxed);
+	slot.ns.fetch_add(ns, std::memory_order_relaxed);
+	if (ns > slot.worst.load(std::memory_order_relaxed)) slot.worst.store(ns, std::memory_order_relaxed);
+}
+
+class Scope {
+public:
+	explicit Scope(Site site) noexcept: m_site(site), m_start(Enabled() ? Now() : 0) {}
+	~Scope() {
+		if (m_start != 0) Add(m_site, Now() - m_start);
+	}
+	Scope(const Scope&)            = delete;
+	Scope& operator=(const Scope&) = delete;
+
+private:
+	Site     m_site;
+	uint64_t m_start;
+};
+
+inline void NoteSubmitted(uint64_t tick) noexcept {
+	if (Enabled()) g_submit_ns[tick & 4095u].store(Now(), std::memory_order_release);
+}
+
+// started: when the wait began; ahead: how many ticks the awaited tick was past the last one known complete.
+inline void NoteTickWait(uint64_t tick, uint64_t started, uint64_t ahead) noexcept {
+	const auto ended     = Now();
+	const auto submitted = g_submit_ns[tick & 4095u].load(std::memory_order_acquire);
+	g_wait_count.fetch_add(1, std::memory_order_relaxed);
+	g_wait_ticks_ahead.fetch_add(ahead, std::memory_order_relaxed);
+	if (submitted > started && submitted <= ended) {
+		g_wait_unsubmitted.fetch_add(1, std::memory_order_relaxed);
+		g_wait_record_ns.fetch_add(submitted - started, std::memory_order_relaxed);
+		g_wait_gpu_ns.fetch_add(ended - submitted, std::memory_order_relaxed);
+	} else {
+		g_wait_gpu_ns.fetch_add(ended - started, std::memory_order_relaxed);
+	}
+}
+
+// Frame timeline (KYTY_FRAME_TRACE=n): time stamped events of 40 consecutive frames, starting after n frames
+// that had gameplay's three or more fetch synchronisations, printed once.
+enum TraceKind : uint32_t {
+	TraceGuestFrameEnd = 1, // guest: reached the end of a frame, waits for the frame before on the GPU
+	TraceGuestFrameGo,      // guest: goes on
+	TraceGuestEnqueue,      // guest: handed a submission to the command processor (value: its type)
+	TraceCpProcess,         // command processor: begins a submission (value: its type)
+	TraceCpSyncBegin,       // command processor: PFP_SYNC_ME, waits for the execution thread (value: place)
+	TraceCpSyncEnd,
+	TraceCpReadBegin,       // command processor: waits for GPU written commands
+	TraceCpReadEnd,
+	TraceExecIdleBegin,     // execution thread: nothing queued
+	TraceExecIdleEnd,
+	TraceExecFrameEnd,      // execution thread: reached the end of a frame
+	TraceGpuFrameDone,      // the GPU completed the frame
+	TraceEopInterrupt,      // an end-of-pipe interrupt is delivered to the guest (GPU completion)
+	TraceGuestReadBegin,    // a guest thread starts waiting for bytes the GPU wrote (value: thread id)
+	TraceGuestReadEnd,
+	TraceLabelDone,         // a label is written at GPU completion
+	TraceBdaPassBegin,      // execution thread: device address full pass begins
+	TraceBdaPassEnd,        // execution thread: device address full pass ends
+};
+
+struct TraceEvent {
+	uint64_t ns    = 0;
+	uint32_t kind  = 0;
+	uint32_t value = 0;
+};
+
+inline std::array<TraceEvent, 1u << 16u> g_trace {};
+inline std::atomic<uint32_t>             g_trace_count {0};
+inline std::atomic<int>                  g_trace_state {0};
+inline std::atomic<uint64_t>             g_trace_frames {0};
+
+inline uint64_t TraceAfterSeconds() noexcept {
+	static const uint64_t seconds = [] {
+		const char* value = std::getenv("KYTY_FRAME_TRACE");
+		return value != nullptr ? std::strtoull(value, nullptr, 10) : 0ull;
+	}();
+	return seconds;
+}
+
+inline bool TraceOn() noexcept {
+	return TraceAfterSeconds() != 0;
+}
+
+inline std::atomic<uint64_t> g_trace_gameplay_frames {0};
+
+// Called by the command processor at the end of a frame that looked like gameplay.
+inline void NoteGameplayFrame() noexcept {
+	if (TraceOn() && g_trace_state.load(std::memory_order_relaxed) == 0 &&
+	    g_trace_gameplay_frames.fetch_add(1, std::memory_order_relaxed) + 1 == TraceAfterSeconds()) {
+		g_trace_frames.store(0, std::memory_order_relaxed);
+		g_trace_state.store(1, std::memory_order_relaxed);
+	}
+}
+
+inline void Trace(uint32_t kind, uint32_t value = 0) noexcept {
+	if (g_trace_state.load(std::memory_order_relaxed) != 1) return;
+	const auto index = g_trace_count.fetch_add(1, std::memory_order_relaxed);
+	if (index < g_trace.size()) g_trace[index] = {Now(), kind, value};
+}
+
+// With KYTY_GPU_BUSY=1 as well: every command buffer's CPU submit time and its GPU top/bottom timestamps (in GPU
+// nanoseconds), printed as [gpu-trace] lines with the trace; the viewer aligns the two clocks.
+struct GpuTraceEvent {
+	uint64_t submit_ns = 0;
+	uint64_t begin_ns  = 0;
+	uint64_t end_ns    = 0;
+	uint64_t tick      = 0;
+};
+inline std::array<GpuTraceEvent, 1u << 14u> g_gpu_trace {};
+inline std::atomic<uint32_t>                g_gpu_trace_count {0};
+
+inline void TraceGpu(uint64_t submit_ns, uint64_t begin_ns, uint64_t end_ns, uint64_t tick) noexcept {
+	if (g_trace_state.load(std::memory_order_relaxed) != 1) return;
+	const auto index = g_gpu_trace_count.fetch_add(1, std::memory_order_relaxed);
+	if (index < g_gpu_trace.size()) g_gpu_trace[index] = {submit_ns, begin_ns, end_ns, tick};
+}
+
+inline void CountFrame() noexcept {
+	if (Enabled()) g_frames.fetch_add(1, std::memory_order_relaxed);
+	if (TraceOn()) {
+		const auto state = g_trace_state.load(std::memory_order_relaxed);
+		if (state == 1 && g_trace_frames.fetch_add(1, std::memory_order_relaxed) == 40) {
+			g_trace_state.store(2, std::memory_order_relaxed);
+			const auto count = std::min<uint32_t>(g_trace_count.load(std::memory_order_relaxed), static_cast<uint32_t>(g_trace.size()));
+			for (uint32_t index = 0; index < count; index++) {
+				std::fprintf(stderr, "[trace] %llu %u %u\n",
+				             static_cast<unsigned long long>((g_trace[index].ns - g_trace[0].ns) / 1000), g_trace[index].kind,
+				             g_trace[index].value);
+			}
+			const auto gpu_count = std::min<uint32_t>(g_gpu_trace_count.load(std::memory_order_relaxed),
+			                                          static_cast<uint32_t>(g_gpu_trace.size()));
+			for (uint32_t index = 0; index < gpu_count && count != 0; index++) {
+				const auto& e = g_gpu_trace[index];
+				if (e.submit_ns < g_trace[0].ns) continue;
+				std::fprintf(stderr, "[gpu-trace] %llu %llu %llu %llu\n",
+				             static_cast<unsigned long long>(e.submit_ns - g_trace[0].ns),
+				             static_cast<unsigned long long>(e.begin_ns), static_cast<unsigned long long>(e.end_ns),
+				             static_cast<unsigned long long>(e.tick));
+			}
+		}
+	}
+}
+
+// Called from the execution thread between operations.
+inline void MaybeReport() noexcept {
+	if (!Enabled()) return;
+	const auto now  = Now();
+	auto       last = g_last_report.load(std::memory_order_relaxed);
+	if (last == 0) {
+		g_last_report.compare_exchange_strong(last, now, std::memory_order_relaxed);
+		return;
+	}
+	if (now - last < 10'000'000'000ull || !g_last_report.compare_exchange_strong(last, now, std::memory_order_relaxed)) return;
+	const auto   frames  = g_frames.exchange(0, std::memory_order_relaxed);
+	const double seconds = static_cast<double>(now - last) / 1e9;
+	const double per     = frames != 0 ? 1.0 / static_cast<double>(frames) : 0.0;
+	std::fprintf(stderr,
+	             "[frame-census] %.2f s, %llu frames (%.2f FPS, %.2f ms each); per frame: %.1f operations, %.1f submits "
+	             "(%.1f empty, %.1f with the GPU already idle)\n",
+	             seconds, static_cast<unsigned long long>(frames), static_cast<double>(frames) / seconds,
+	             frames != 0 ? seconds * 1000.0 / static_cast<double>(frames) : 0.0,
+	             static_cast<double>(g_ops.exchange(0, std::memory_order_relaxed)) * per,
+	             static_cast<double>(g_submits.exchange(0, std::memory_order_relaxed)) * per,
+	             static_cast<double>(g_empty_submits.exchange(0, std::memory_order_relaxed)) * per,
+	             static_cast<double>(g_gpu_idle_submits.exchange(0, std::memory_order_relaxed)) * per);
+	for (uint32_t site = 0; site < Count; site++) {
+		auto&      slot  = g_slots[site];
+		const auto count = slot.count.exchange(0, std::memory_order_relaxed);
+		const auto ns    = slot.ns.exchange(0, std::memory_order_relaxed);
+		const auto worst = slot.worst.exchange(0, std::memory_order_relaxed);
+		if (count == 0) continue;
+		std::fprintf(stderr, "[frame-census]   %-17s %8.3f ms/frame  %9.1f /frame  avg %8.2f us  worst %8.3f ms\n", Names[site],
+		             static_cast<double>(ns) / 1e6 * per, static_cast<double>(count) * per,
+		             static_cast<double>(ns) / 1e3 / static_cast<double>(count), static_cast<double>(worst) / 1e6);
+	}
+	for (auto& slot: g_fault_slots) {
+		const char* name = slot.name.load(std::memory_order_acquire);
+		if (name == nullptr) break;
+		const auto reads  = slot.reads.exchange(0, std::memory_order_relaxed);
+		const auto writes = slot.writes.exchange(0, std::memory_order_relaxed);
+		const auto ns     = slot.ns.exchange(0, std::memory_order_relaxed);
+		if (reads + writes == 0) continue;
+		std::fprintf(stderr, "[frame-census]   exec fault in %-22s %8.3f ms/frame  %7.1f reads %7.1f writes /frame\n", name,
+		             static_cast<double>(ns) / 1e6 * per, static_cast<double>(reads) * per,
+		             static_cast<double>(writes) * per);
+	}
+	std::fprintf(stderr, "[frame-census]   copy worker: %.2f MiB/frame copied\n",
+	             static_cast<double>(g_worker_bytes.exchange(0, std::memory_order_relaxed)) / 1048576.0 * per);
+	if (const auto waits = g_wait_count.exchange(0, std::memory_order_relaxed); waits != 0) {
+		std::fprintf(stderr,
+		             "[frame-census]   tick waits of the execution thread: %.1f /frame, %.1f of them for a tick the recorder had "
+		             "not submitted yet; %.3f ms/frame until it was submitted, %.3f ms/frame for the GPU after; the tick was "
+		             "%.1f ticks past the last complete one on average\n",
+		             static_cast<double>(waits) * per,
+		             static_cast<double>(g_wait_unsubmitted.exchange(0, std::memory_order_relaxed)) * per,
+		             static_cast<double>(g_wait_record_ns.exchange(0, std::memory_order_relaxed)) / 1e6 * per,
+		             static_cast<double>(g_wait_gpu_ns.exchange(0, std::memory_order_relaxed)) / 1e6 * per,
+		             static_cast<double>(g_wait_ticks_ahead.exchange(0, std::memory_order_relaxed)) / static_cast<double>(waits));
+	}
+	const auto threads = std::min<uint32_t>(g_thread_fault_slots.load(std::memory_order_relaxed),
+	                                        static_cast<uint32_t>(g_thread_faults.size()));
+	for (uint32_t index = 0; index < threads; index++) {
+		auto&      slot     = g_thread_faults[index];
+		const auto reads    = slot.reads.exchange(0, std::memory_order_relaxed);
+		const auto writes   = slot.writes.exchange(0, std::memory_order_relaxed);
+		const auto read_ns  = slot.read_ns.exchange(0, std::memory_order_relaxed);
+		const auto write_ns = slot.write_ns.exchange(0, std::memory_order_relaxed);
+		const auto worst    = slot.worst_ns.exchange(0, std::memory_order_relaxed);
+		if (static_cast<double>(read_ns + write_ns) / 1e6 * per < 0.02) continue;
+		std::fprintf(stderr,
+		             "[frame-census]   faults on %-28s read %6.1f /frame %7.3f ms/frame   write %7.1f /frame %7.3f ms/frame   "
+		             "worst %7.3f ms\n",
+		             slot.name, static_cast<double>(reads) * per, static_cast<double>(read_ns) / 1e6 * per,
+		             static_cast<double>(writes) * per, static_cast<double>(write_ns) / 1e6 * per,
+		             static_cast<double>(worst) / 1e6);
+	}
+}
+
+}
