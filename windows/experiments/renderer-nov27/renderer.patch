+#if KYTY_PLATFORM == KYTY_PLATFORM_WINDOWS
+// Every page of the host range is committed and writable, so the driver can lock it.
+static bool HostRangeImportable(const uint8_t* begin, uint64_t bytes) {
+	const auto* end = begin + bytes;
+	while (begin < end) {
+		MEMORY_BASIC_INFORMATION info {};
+		if (VirtualQuery(begin, &info, sizeof(info)) == 0 || info.State != MEM_COMMIT ||
+		    (info.Protect & (PAGE_READWRITE | PAGE_WRITECOPY)) == 0 || (info.Protect & PAGE_GUARD) != 0) {
+			return false;
+		}
+		begin = static_cast<const uint8_t*>(info.BaseAddress) + info.RegionSize;
+	}
+	return true;
+}
+#else
+static bool HostRangeImportable(const uint8_t*, uint64_t) {
+	return false;
+}
+#endif
+
+bool BufferCache::RequestHostChunk(uint64_t address, const uint8_t* host, uint64_t size) {
+	const void* view        = nullptr;
+	uint64_t    guest_bytes = 0, view_bytes = 0;
+	if (!LibKernel::Memory::BackingViewRange(&view, &guest_bytes, &view_bytes)) {
+		return false;
+	}
+	const auto* base = static_cast<const uint8_t*>(view);
+	if (host < base || static_cast<uint64_t>(host - base) > view_bytes - size) {
+		return false;
+	}
+	const auto offset = static_cast<uint64_t>(host - base);
+	const bool direct = offset >= guest_bytes;
+	// An import stalls every queue submission while the kernel makes it, so there must be few of them:
+	// take the largest of these ranges around the buffer that the host has committed.
+	static const uint64_t largest = std::max<uint64_t>(AliasSetting("KYTY_ALIAS_CHUNK_MIB", 256), 1) * 1024 * 1024;
+	for (auto bytes = largest; bytes >= 64 * 1024; bytes /= 16) {
+		const auto low  = direct ? guest_bytes : uint64_t {0};
+		const auto high = direct ? view_bytes : guest_bytes;
+		auto       from = std::max(Common::AlignDown(offset, bytes), low);
+		const auto to   = std::min(Common::AlignDown(offset, bytes) + bytes, high);
+		if (offset < from || offset + size > to) {
+			continue;
+		}
+		from = Common::AlignUp(from, uint64_t {4096});
+		const auto length = Common::AlignDown(to - from, uint64_t {4096});
+		if (offset < from || offset + size > from + length || !HostRangeImportable(base + from, length)) {
+			continue;
+		}
+		auto chunk = std::make_shared<HostChunk>(m_graphics, const_cast<uint8_t*>(base) + from, length,
+		                                         direct ? uint64_t {0} : address - (offset - from));
+		m_host_chunks.push_back(chunk);
+		m_alias_stats.chunks++;
+		Common::WriteJournal::Note(Common::WriteJournal::Import, from, length, address);
+		std::fprintf(stderr, "[alias-buffers] importing %.1f MiB of %s memory at view offset 0x%llx\n",
+		             static_cast<double>(length) / 1048576.0, direct ? "direct" : "mirrored guest",
+		             static_cast<unsigned long long>(from));
+		{
+			std::lock_guard lock(m_host_chunk_mutex);
+			m_host_chunk_jobs.push_back(std::move(chunk));
+			if (!m_host_chunk_thread.joinable()) {
+				m_host_chunk_thread = std::jthread([this](std::stop_token stop) { HostChunkWorker(stop); });
+			}
+		}
+		m_host_chunk_wake.notify_one();
+		return true;
+	}
+	return false;
+}
+
+void BufferCache::HostChunkWorker(std::stop_token stop) {
+	for (;;) {
+		std::shared_ptr<HostChunk> chunk;
+		{
+			std::unique_lock lock(m_host_chunk_mutex);
+			if (!m_host_chunk_wake.wait(lock, stop, [this] { return !m_host_chunk_jobs.empty(); })) {
+				return;
+			}
+			chunk = std::move(m_host_chunk_jobs.front());
+			m_host_chunk_jobs.pop_front();
+		}
+		chunk->Import();
+	}
+}
+
+void BufferCache::RetireHostChunks(uint64_t vaddr, uint64_t size) {
+	if (m_host_chunks.empty() || size == 0) {
+		return;
+	}
+	std::erase_if(m_host_chunks, [&](const std::shared_ptr<HostChunk>& chunk) {
+		if (chunk->guest_begin != 0 && chunk->guest_begin < vaddr + size && vaddr < chunk->guest_begin + chunk->size) {
+			chunk->retired = true;
+			return true;
+		}
+		return false;
+	});
+}
