+// Largest buffer that may become guest memory, in bytes (KYTY_ALIAS_MAX_KIB, default 64).
+uint64_t AliasMaxSize() {
+	static const uint64_t size = AliasSetting("KYTY_ALIAS_MAX_KIB", 64) * 1024;
+	return size;
+}
+
+// KYTY_ALIAS_GPU_WRITES=1: a buffer that is guest memory stays so when the GPU writes it through a bound
+// buffer or a copy.  The GPU then writes guest memory itself; the pages are kept from the guest as for any
+// GPU write, and a guest that comes for them waits for the write and nothing is copied back.
+bool AliasGpuWrites() {
+	static const bool on = AliasSetting("KYTY_ALIAS_GPU_WRITES", 0) != 0;
+	return on;
+}
+
+// KYTY_ALIAS_GPU_FILLS=1 (with KYTY_ALIAS_GPU_WRITES=1): a fill or copy the guest asked the GPU for, into a
+// buffer that is guest memory, is done by the GPU in its place among the recorded commands.  Done at once
+// by the execution thread it would be seen by commands recorded earlier that the GPU has not run yet.
+bool AliasGpuFills() {
+	static const bool on = AliasGpuWrites() && AliasSetting("KYTY_ALIAS_GPU_FILLS", 0) != 0;
+	return on;
+}
+
+// Largest GPU write a shared buffer takes and stays shared (KYTY_ALIAS_GPU_WRITE_MAX_KIB, default 16): the
+// GPU writes system memory far more slowly than its own.
+uint64_t AliasGpuWriteMax() {
+	static const uint64_t bytes = AliasSetting("KYTY_ALIAS_GPU_WRITE_MAX_KIB", 16) * 1024;
+	return bytes;
+}
