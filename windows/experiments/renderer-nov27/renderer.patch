+inline void BeginSarosGraphicsBucket(RenderContext& context, const CommandRecorder& command,
+                                     uint32_t width, uint32_t height, uint32_t colors, bool depth) {
+	if (!SarosBucketTimerState::Enabled()) return;
+	const uint64_t tag = (static_cast<uint64_t>(width) & 0xffffu) |
+	                     ((static_cast<uint64_t>(height) & 0xffffu) << 16u) |
+	                     ((static_cast<uint64_t>(colors) & 0xffu) << 32u) |
+	                     (static_cast<uint64_t>(depth ? 1u : 0u) << 40u);
+	auto& state = SarosBucketTimerState::Instance();
+	state.graphics_handle = BeginSarosBucket(context, command, SarosBucket::Graphics, tag);
+}
+
+inline void EndSarosGraphicsBucket(RenderContext& context, const CommandRecorder& command) {
+	if (!SarosBucketTimerState::Enabled()) return;
+	auto& state = SarosBucketTimerState::Instance();
+	const uint32_t h = std::exchange(state.graphics_handle, kInvalidSarosBucket);
+	EndSarosBucket(context, command, h);
+}
