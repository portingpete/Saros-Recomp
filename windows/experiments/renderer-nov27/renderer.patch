+void BufferCache::NoteGpuBytesRead(uint64_t address, const void* bytes, uint32_t size) {
+	if (!GpuPeekOn() || size == 0 || size > 32 || !GuestGpu::IsGpuThread()) return;
+	// Only a read that had to wait for the GPU gets a history: the mirrored read of these bytes just
+	// waited for its tick, or the execution thread just faulted on their page.
+	const bool blocked = m_gpu_peek_blocked_address == address ||
+	                     m_gpu_peek_blocked_page == (address & ~uint64_t {TRACKER_PAGE_SIZE - 1});
+	m_gpu_peek_blocked_address = 0;
+	m_gpu_peek_blocked_page    = 0;
+	if (!blocked) return;
+	NotePeekOrder(address, bytes, size, m_gc_tick);
+	if (OrderedPeekOn()) {
+		LearnOrderedPeek(address, bytes, size);
+	}
+	std::array<uint8_t, 32> seen {};
+	std::memcpy(seen.data(), bytes, size);
+	std::lock_guard lock(m_gpu_peek_mutex);
+	g_gpu_peek_stats.waited.fetch_add(1, std::memory_order_relaxed);
+	if (auto* peek = FindGpuPeek(address, size, seen.data(), false); peek != nullptr) {
+		peek->confirmed++;
+		peek->noted++;
+		peek->shader = Common::HackNotice::CurrentShaderSlot();
+	} else {
+		g_gpu_peek_stats.waited_changed.fetch_add(1, std::memory_order_relaxed);
+		if (auto* fresh = FindGpuPeek(address, size, seen.data(), true); fresh != nullptr) {
