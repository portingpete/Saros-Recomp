+void HostChunk::Import() noexcept {
+	constexpr uint64_t HostPage = 4096;
+	constexpr auto     Kind     = vk::ExternalMemoryHandleTypeFlagBits::eHostAllocationEXT;
+	vk::MemoryHostPointerPropertiesEXT host_properties {};
+	if (!graphics->external_memory_host_enabled || host == nullptr || size == 0 ||
+	    (reinterpret_cast<uintptr_t>(host) | size) % HostPage != 0 ||
+	    graphics->device.getMemoryHostPointerPropertiesEXT(Kind, host, &host_properties) != vk::Result::eSuccess ||
+	    host_properties.memoryTypeBits == 0) {
+		state.store(Failed, std::memory_order_release);
+		return;
+	}
+	vk::ImportMemoryHostPointerInfoEXT import_info {};
+	import_info.handleType   = Kind;
+	import_info.pHostPointer = host;
+	vk::MemoryAllocateFlagsInfo flags_info {};
+	flags_info.pNext = &import_info;
+	flags_info.flags = vk::MemoryAllocateFlagBits::eDeviceAddress;
+	vk::MemoryAllocateInfo allocate_info {};
+	allocate_info.pNext           = &flags_info;
+	allocate_info.allocationSize  = size;
+	allocate_info.memoryTypeIndex = static_cast<uint32_t>(std::countr_zero(host_properties.memoryTypeBits));
+	vk::DeviceMemory imported;
+	if (graphics->device.allocateMemory(&allocate_info, nullptr, &imported) != vk::Result::eSuccess) {
+		state.store(Failed, std::memory_order_release);
+		return;
+	}
+	memory = imported;
+	state.store(Ready, std::memory_order_release);
+}
