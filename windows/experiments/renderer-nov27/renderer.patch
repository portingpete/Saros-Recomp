+// Ordered prediction of GPU written bytes (KYTY_GPU_PEEK_ORDERED=1).
+//
+// Before the execution thread uses a dispatch that was resolved ahead of time it reads a few bytes the GPU
+// wrote a moment ago, and waits for the GPU to get there.  In Saros that is one word, written twice a
+// frame, and what it holds depends only on which of the frame's writes came last: after the first it is
+// one value, after the second another, the same every frame.  So the value is kept per address and per
+// number of GPU writes to it so far in the frame.  Once a place has shown the same value often enough, a
+// read is answered from it at once, and a copy of the real bytes, taken at the same point of the command
+// stream, is compared when the GPU has made it.  A wrong answer means one dispatch was prepared from a
+// stale word; the place then has to prove itself again with real reads, and an address that is wrong
+// repeatedly is left alone for a while.  All of this is under m_gpu_peek_mutex.
+namespace {
+// KYTY_GPU_PEEK_ORDERED=1 is the first form: any watched value is answered from its history after eight
+// equal reads, pointers and descriptors included.  About a third of the runs made with it logged a wrong
+// answer or two, at transitions.  KYTY_GPU_PEEK_ORDERED=2 is the careful form:
+//   - a value is answered from what guest memory holds now when eight waited reads in a row found the GPU's
+//     bytes equal to what guest memory held before them: the GPU does not change those bytes although they
+//     lie in a range it has bound for writing.  A pointer the guest changes is then followed at once, where
+//     the first form would answer the old one;
+//   - a value is answered from the order of writes only when it is a small number (a flag or a count below
+//     256) that the GPU was last seen to change and that has been the same at its place 32 times in a row;
+//   - anything else is read with a wait, as without the switch;
+//   - one wrong answer bars the address for a minute, a second one for good.
+constexpr uint32_t OrderedConfirmations = 8;
+constexpr uint32_t OrderedFromMemory    = 8;
+constexpr uint32_t OrderedCareful       = 32;
+constexpr uint32_t OrderedPlaces        = 8;
+constexpr size_t   OrderedMaxEntries    = 64;
+
+struct OrderedPeek {
+	uint64_t address      = 0;
+	uint32_t size         = 0;
+	uint64_t frame        = 0;
+	uint32_t writes       = 0; // GPU writes over the bytes so far in this frame
+	uint64_t write_seq    = 0; // GPU writes over the bytes since it is watched
+	uint64_t checked_seq  = UINT64_MAX;
+	uint64_t barred_until = 0;
+	uint32_t misses       = 0;
+	uint64_t last_miss    = 0; // frame of the last wrong answer
+	uint64_t id           = 0; // changes when the slot is given to other bytes
+	uint64_t last_use     = 0;
+	struct Place {
+		std::array<uint8_t, 32> value {};
+		uint32_t                confirmed = 0;
+		uint32_t                cpu_same  = 0;     // waited reads in a row that found the GPU's bytes equal to guest memory
+		bool                    gpu_wrote = false; // the last waited read found bytes guest memory did not hold
+		uint64_t                answered  = 0;
+		uint64_t                waited    = 0;
+	};
+	std::array<Place, OrderedPlaces> places {};
+};
