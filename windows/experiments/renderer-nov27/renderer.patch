+	             "last %llu written to %s\n",
+	             static_cast<unsigned long long>(fault_address), static_cast<unsigned long long>(rip),
+	             static_cast<unsigned long long>(next), static_cast<unsigned long long>(next < Count ? next : Count), name);
+	return index;
+#else
+	return -1;
+#endif
+}
