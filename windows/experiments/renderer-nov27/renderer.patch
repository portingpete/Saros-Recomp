+std::shared_ptr<HostChunk> BufferCache::FindHostChunk(const uint8_t* host, uint64_t size) const {
+	for (const auto& chunk: m_host_chunks) {
+		if (!chunk->retired && chunk->Covers(host, size)) {
+			return chunk;
+		}
+	}
+	return nullptr;
+}
