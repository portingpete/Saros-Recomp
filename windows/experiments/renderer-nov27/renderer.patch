+void BufferCache::DrainHostCopiesForWrite(uint64_t vaddr, uint64_t size, bool already_invalidated) {
+	if (!SmartCopyDrainEnabled()) {
+		DrainHostCopies();
+		return;
+	}
+	auto* copies = m_scheduler.HostCopies();
+	if (copies == nullptr || !GuestGpu::IsGpuThread() || size == 0) {
+		return;
+	}
+	bool need_copies = true;
+	bool need_writes = copies->HasPendingGuestWrites();
+	if (const void* backing = LibKernel::Memory::FindBackingPointer(vaddr, size); backing != nullptr) {
+		need_copies = copies->MayReadFrom(backing, size);
+		if (need_writes) {
+			need_writes = copies->MayWriteTo(backing, size);
+		}
+	} else {
+		thread_local std::vector<std::pair<const uint8_t*, uint64_t>> write_pieces;
+		if (LibKernel::Memory::TryGetBackingPieces(vaddr, size, write_pieces)) {
+			need_copies = false;
+			need_writes = false;
+			for (const auto& piece: write_pieces) {
+				if (!need_copies && copies->MayReadFrom(piece.first, piece.second)) {
+					need_copies = true;
+				}
+				if (!need_writes && copies->MayWriteTo(piece.first, piece.second)) {
+					need_writes = true;
+				}
+				if (need_copies && need_writes) {
+					break;
+				}
+			}
+		}
+	}
+	if (!already_invalidated) {
+		if (auto* protections = ProtectionLane::find(copies)) {
+			const auto first_region = vaddr / TRACKER_REGION_SIZE;
+			const auto last_region  = (vaddr + size - 1) / TRACKER_REGION_SIZE;
+			for (auto r = first_region; r <= last_region; ++r) {
+				if (m_memory_tracker.DeferredProtectionPending(r * TRACKER_REGION_SIZE)) {
+					protections->WaitRegion(r * TRACKER_REGION_SIZE);
+				}
+			}
+		}
+	}
+	if (need_copies) {
+		copies->Drain();
+	}
+	if (need_writes) {
+		copies->WaitGuestWrites();
+	}
+}
+
+void BufferCache::FlushDeferredProtectsToLane() {
+	auto& deferred = MemoryTracker::DeferredProtects();
+	if (deferred.empty()) {
+		return;
+	}
+	auto* host_copies = m_scheduler.HostCopies();
+	auto* protections = ProtectionLane::find(host_copies);
+	if (host_copies != nullptr && GuestGpu::IsGpuThread()) {
+		const auto apply_protect = [](void* manager, uint64_t address, uint64_t size) {
+			static_cast<RegionManager*>(manager)->ApplyDeferredProtection(address, size);
+		};
+		for (const auto& item: deferred) {
+			if (protections) {
+				protections->Queue(item.address, apply_protect, item.manager, item.address, item.size);
+			} else {
+				host_copies->Call(apply_protect, item.manager, item.address, item.size);
+			}
+		}
+		m_protect_jobs = protections ? ProtectionLane::publish(*host_copies, *protections) : host_copies->Flush();
+	} else {
+		if (protections && m_protect_jobs != 0) {
+			protections->WaitAll();
+			m_protect_jobs = 0;
+		}
+		for (const auto& item: deferred) {
+			item.manager->ApplyDeferredProtection(item.address, item.size);
+		}
+	}
+	deferred.clear();
+}
+
+bool BufferCache::InGuestMemoryBuffer(uint64_t vaddr, uint64_t size) {
+	if (m_alias_live == 0 || size == 0) {
+		return false;
+	}
+	for (const auto address: {vaddr, vaddr + size - 1}) {
+		const auto* owner = m_page_table.Find(address >> PageTable::kPageBits);
+		if (owner != nullptr && *owner) {
+			if (const auto* buffer = GetBufferIfLive(*owner); buffer != nullptr && buffer->IsHostMemory()) {
+				return true;
+			}
+		}
+	}
+	return false;
