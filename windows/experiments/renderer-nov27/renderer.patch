+// Eager readback (KYTY_EAGER_READBACK=1).  A guest thread that touches a page the GPU has written waits
+// for a round trip through the execution thread and the GPU, although the GPU has usually finished the
+// data long before.  Pages that cost such a wait are remembered; the next GPU write to them is followed
+// by a copy into a feedback slot in the same submission, and once that submission is complete the
+// execution thread writes the bytes to guest memory and opens the pages, so the guest finds them ready.
+// A guest that comes earlier takes the old path.  Device-address writers are only learned after the
+// fact, so memory they have ever written is left out.
+// KYTY_EAGER_READBACK=1: every range the guest was seen to wait for.  =2: only the copies the guest asks the
+// GPU to make into plain memory (DMA), a handful of small ranges a frame that it reads back soon after.
+static int EagerReadbackMode() {
+	static const int mode = [] {
+		const char* value = std::getenv("KYTY_EAGER_READBACK");
+		return value != nullptr && (value[0] == '1' || value[0] == '2') ? value[0] - '0' : 0;
+	}();
+	return mode;
+}
+
+static bool EagerReadbackOn() {
+	return EagerReadbackMode() != 0;
+}
+
+namespace {
+constexpr uint64_t EagerPageBits    = 12;
+constexpr uint64_t EagerGranuleBits = 20;
+constexpr uint64_t EagerWriterBits  = 16;
+constexpr size_t   EagerTableBits   = 16;
+constexpr uint64_t EagerMaxBytes    = 2ull * 1024 * 1024;
+constexpr uint64_t EagerUnitBits    = 16;
+constexpr uint64_t EagerWantedBytes = 256ull * 1024;
+
+size_t EagerSlot(uint64_t key) {
+	return static_cast<size_t>((key * 0x9e3779b97f4a7c15ull) >> (64 - EagerTableBits));
+}
+
+struct EagerStats {
+	uint64_t marked         = 0;
+	uint64_t scheduled      = 0;
+	uint64_t bytes          = 0;
+	uint64_t applied        = 0;
+	uint64_t failed         = 0;
+	uint64_t device_address = 0;
+	uint64_t refused        = 0;
+	uint64_t probes         = 0;
+	uint64_t dropped        = 0;
+	uint64_t wanted         = 0;
+} g_eager_stats;
+}
+
+static void LogEagerStats() {
+	if (!EagerReadbackOn()) {
+		return;
+	}
+	const auto stats = std::exchange(g_eager_stats, {});
+	std::fprintf(stderr,
+	             "[eager-readback] %llu pages learned, %llu copies scheduled (%.1f MiB), %llu applied, %llu not applied, "
+	             "%llu left to device address writers, %llu refused; %llu probes, %llu units dropped; %llu GPU copies taken\n",
+	             static_cast<unsigned long long>(stats.marked), static_cast<unsigned long long>(stats.scheduled),
+	             static_cast<double>(stats.bytes) / 1048576.0, static_cast<unsigned long long>(stats.applied),
+	             static_cast<unsigned long long>(stats.failed), static_cast<unsigned long long>(stats.device_address),
+	             static_cast<unsigned long long>(stats.refused), static_cast<unsigned long long>(stats.probes),
+	             static_cast<unsigned long long>(stats.dropped), static_cast<unsigned long long>(stats.wanted));
+}
+
+void BufferCache::NoteEagerPages(uint64_t begin, uint64_t end, uint64_t served_end) {
+	if (begin >= end || EagerReadbackMode() == 2) {
+		return;
+	}
+	served_end = std::max(served_end, end);
+	if (m_eager_pages.empty()) {
+		m_eager_pages.assign(size_t {1} << EagerTableBits, 0);
+		m_eager_granules.assign(size_t {1} << EagerTableBits, 0);
+		m_eager_units.assign(size_t {1} << EagerTableBits, {});
+	}
+	for (auto page = begin >> EagerPageBits; page <= (end - 1) >> EagerPageBits; page++) {
+		auto& slot = m_eager_pages[EagerSlot(page)];
+		if (slot != page + 1) {
+			slot = page + 1;
+			g_eager_stats.marked++;
+		}
+	}
+	for (auto granule = begin >> EagerGranuleBits; granule <= (end - 1) >> EagerGranuleBits; granule++) {
+		m_eager_granules[EagerSlot(granule)] = granule + 1;
+	}
+	// A wait is the evidence that the guest reads this memory: it ends a probe, for every unit the readback
+	// served, since the guest then reads on through the read ahead without another wait.
+	for (auto unit = begin >> EagerUnitBits; unit <= (served_end - 1) >> EagerUnitBits; unit++) {
+		auto& state = m_eager_units[EagerSlot(unit)];
+		if (state.key != unit + 1) {
+			state = {unit + 1, 0, 0, false};
+		}
+		if (state.probe != 0) {
+			// Decide again for the rest of this frame: the unit is read.
+			state.probe = 0;
+			state.frame = 0;
+		}
+	}
+}
+
+// Whether GPU writes to this 64 KiB unit are copied back eagerly in the current frame.  Every eighth frame
+// a unit is left alone as a probe: if the guest then does not come and wait for it, nobody reads it any
+// more and its pages are forgotten.
+bool BufferCache::EagerUnitWanted(uint64_t unit) {
+	auto&      state = m_eager_units[EagerSlot(unit)];
+	const auto frame = static_cast<uint32_t>(m_gc_tick) + 2;
+	if (state.key != unit + 1) {
+		state = {unit + 1, 0, 0, false};
+	}
+	if (state.frame == frame) {
+		return state.eager;
+	}
+	state.frame = frame;
+	if (state.probe != 0 && frame - state.probe >= 2) {
+		for (auto page = unit << (EagerUnitBits - EagerPageBits); page < (unit + 1) << (EagerUnitBits - EagerPageBits); page++) {
+			auto& slot = m_eager_pages[EagerSlot(page)];
+			if (slot == page + 1) {
+				slot = 0;
+			}
+		}
+		state.probe = 0;
+		state.eager = false;
+		g_eager_stats.dropped++;
+		return false;
+	}
+	if (state.probe != 0) {
+		state.eager = false;
+	} else if (((frame + (unit >> 4u)) & 31u) == 0) {
+		// The units of a megabyte are probed in the same frame, so the read ahead of one wait cannot hide
+		// that its neighbours are read.
+		state.probe = frame;
+		state.eager = false;
+		g_eager_stats.probes++;
+	} else {
+		state.eager = true;
+	}
+	return state.eager;
+}
+
+void BufferCache::NoteEagerDeviceAddressWrite(uint64_t vaddr, uint64_t size) {
+	if (size == 0) {
+		return;
+	}
+	if (m_eager_writers.empty()) {
+		m_eager_writers.assign(size_t {1} << EagerTableBits, 0);
+	}
+	for (auto granule = vaddr >> EagerWriterBits; granule <= (vaddr + size - 1) >> EagerWriterBits; granule++) {
+		m_eager_writers[EagerSlot(granule)] = granule + 1;
+	}
+}
