+// Writes the ring to a file: at most twelve times a process and not twice within a second.  Returns the
+// number of the file, or -1 when nothing was written.
+inline int Dump(uint64_t rip, uint64_t fault_address) noexcept {
+	if (!Enabled()) {
+		return -1;
