+bool GuestGpu::HasResolvedWriteOverlap(uint64_t executed, uint64_t before_seq, uint64_t begin, uint64_t end,
+                                       uint8_t* out_hit_reason, uint64_t* out_hit_seq, bool* out_only_opaque) {
