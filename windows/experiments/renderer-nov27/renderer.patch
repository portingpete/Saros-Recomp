+// Prediction guard window (KYTY_GUARD_PREDICTIONS=1): GPU written words answered from history between the start
+// of a dispatch's preparation and Close are checked on the GPU right before the dispatch, which then runs under
+// conditional rendering on the result (see BufferCache::RecordPredictionCheck).
+namespace {
+struct PredictionWindow {
+	BufferCache& cache;
+	bool         open = true;
+	explicit PredictionWindow(BufferCache& c): cache(c) { cache.BeginPredictionGuard(); }
+	PredictionWindow(const PredictionWindow&)            = delete;
+	PredictionWindow& operator=(const PredictionWindow&) = delete;
+	~PredictionWindow() {
+		if (open) {
+			thread_local std::vector<BufferCache::GuardWord> discarded;
+			bool                                             any = false;
+			(void)cache.EndPredictionGuard(discarded, any);
+		}
+	}
+	// Ends collection and records the check; true when the next dispatch must run under the predicate.
+	bool Close(const CommandRecorder& command, vk::Buffer& predicate, uint64_t& offset, uint64_t shader_hash, int frame) {
+		if (!open) return false;
+		open = false;
+		thread_local std::vector<BufferCache::GuardWord> words;
+		bool       any     = false;
+		const bool ok      = cache.EndPredictionGuard(words, any);
+		const bool guarded = ok && !words.empty() && cache.RecordPredictionCheck(command, words, predicate, offset);
+		if (any) {
+			cache.NoteGuardedDispatch(guarded);
+			static uint32_t shown = 0;
+			if (shown < 6 && frame > 600) {
+				++shown;
+				std::fprintf(stderr, "[prediction-guard] shader %016llx: %s, %zu words:", static_cast<unsigned long long>(shader_hash),
+				             guarded ? "guarded" : ok ? "no words" : "not guardable", words.size());
+				for (const auto& word: words) {
+					std::fprintf(stderr, " %llx=%08x/%08x", static_cast<unsigned long long>(word.device_address), word.expected,
+					             word.mask);
+				}
+				std::fprintf(stderr, "\n");
+			}
+		}
+		return guarded;
+	}
+};
