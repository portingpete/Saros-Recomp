+	const auto assumed         = stats.assumed.exchange(0, std::memory_order_relaxed);
+	const auto waited          = stats.waited.exchange(0, std::memory_order_relaxed);
+	const auto waited_changed  = stats.waited_changed.exchange(0, std::memory_order_relaxed);
+	const auto checked         = stats.checked.exchange(0, std::memory_order_relaxed);
+	const auto checked_changed = stats.checked_changed.exchange(0, std::memory_order_relaxed);
+	if (assumed + waited + checked == 0) return;
