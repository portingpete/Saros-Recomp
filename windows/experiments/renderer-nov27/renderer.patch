+		while (j < pages.size() && pages[j].region == region) {
+			++j;
+		}
+		Common::SmallVector<RegionManager::ReadbackPageRelease, 32> batch;
+		for (size_t k = i; k < j; ++k) {
+			batch.push_back({
+			    .page         = pages[k].page_index,
+			    .expected_gen = pages[k].expected_gen,
+			    .wants_write  = ticket->wants_write[k].load(std::memory_order_acquire) != 0,
+			});
+		}
+		region->ReleaseReadbackPages(
+		    std::span<RegionManager::ReadbackPageRelease>(batch.data(), batch.size()),
+		    [this](uint64_t page_vaddr) { ClearGpuLinePageLocked(page_vaddr); });
+		const auto* batch_data = batch.data();
+		for (size_t k = 0; k < batch.size(); ++k) {
+			pages[i + k].released   = batch_data[k].released;
+			pages[i + k].cpu_marked = batch_data[k].cpu_marked;
+			if (!batch_data[k].released) {
