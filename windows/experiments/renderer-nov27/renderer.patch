+// A read that waited for the GPU found these bytes.
+void BufferCache::LearnOrderedPeek(uint64_t address, const void* bytes, uint32_t size) {
+	std::lock_guard lock(m_gpu_peek_mutex);
+	auto*           entry = FindOrdered(address, size);
+	if (entry == nullptr) {
+		if (g_ordered.size() < OrderedMaxEntries) {
+			g_ordered.reserve(OrderedMaxEntries);
+			entry = &g_ordered.emplace_back();
+		} else {
+			// The bytes that were read longest ago make room: many addresses are read once while a level loads.
+			entry = &*std::min_element(g_ordered.begin(), g_ordered.end(),
+			                           [](const OrderedPeek& a, const OrderedPeek& b) { return a.last_use < b.last_use; });
+			*entry = {};
+		}
+		entry->address     = address;
+		entry->size        = size;
+		entry->id          = ++g_ordered_ids;
+		m_ordered_tracking = true;
+	}
+	entry->last_use = m_gc_tick;
+	auto& place     = OrderedPlace(*entry, m_gc_tick);
+	if (place.confirmed != 0 && std::memcmp(place.value.data(), bytes, size) == 0) {
+		place.confirmed++;
+	} else {
+		std::memcpy(place.value.data(), bytes, size);
+		place.confirmed = 1;
+	}
+	// What guest memory held before this read brought the GPU's bytes back.  Unknown counts as changed.
+	const bool known = m_ordered_before_size != 0 && m_ordered_before_address <= address &&
+	                   address + size <= m_ordered_before_address + m_ordered_before_size;
+	const bool same  = known && std::memcmp(m_ordered_before.data() + (address - m_ordered_before_address), bytes, size) == 0;
+	place.cpu_same   = same ? place.cpu_same + 1 : 0;
+	place.gpu_wrote  = known && !same;
+	place.waited++;
+	g_ordered_stats.learned++;
