+template <typename VecA, typename VecB>
+bool HazardRangesOverlap(const VecA& a, const VecB& b) noexcept {
+	for (const auto& ra: a) {
+		for (const auto& rb: b) {
+			if (ra.begin < rb.end && rb.begin < ra.end) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+template <typename DstVec>
+void AppendHazardRanges(DstVec& dst, bool& dst_opaque, const std::vector<ComputeHazardRangeLocal>& src,
+                        bool src_opaque) {
+	if (src_opaque) {
+		dst_opaque = true;
+	}
+	if (dst_opaque) {
+		return;
+	}
+	for (const auto& r: src) {
+		bool dup = false;
+		for (const auto& e: dst) {
+			if (e.begin == r.begin && e.end == r.end) {
+				dup = true;
+				break;
+			}
+		}
+		if (!dup) {
+			if (dst.size() >= MaxTrackedComputeHazardRanges) {
+				dst_opaque = true;
+				return;
+			}
+			dst.push_back({r.begin, r.end});
+		}
+	}
+}
