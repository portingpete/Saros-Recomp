+// The Vulkan buffers that are guest memory, by handle, so that any command that writes one can be seen.
+inline std::mutex                                                   g_shared_mutex;
+inline std::unordered_map<uint64_t, std::pair<uint64_t, uint64_t>> g_shared_buffers;
+inline std::atomic<uint32_t>                                        g_shared_count {0};
+inline std::atomic<uint64_t>                                        g_into_shared {0};
+
+inline void AddShared(uint64_t handle, uint64_t address, uint64_t size) {
+	std::lock_guard lock(g_shared_mutex);
+	g_shared_buffers[handle] = {address, size};
+	g_shared_count.store(static_cast<uint32_t>(g_shared_buffers.size()), std::memory_order_relaxed);
+}
+
+inline void RemoveShared(uint64_t handle) {
+	std::lock_guard lock(g_shared_mutex);
+	g_shared_buffers.erase(handle);
+	g_shared_count.store(static_cast<uint32_t>(g_shared_buffers.size()), std::memory_order_relaxed);
