+
+void BufferCache::NoteAliasEmulatorWrite(uint64_t vaddr, uint64_t size) {
+	if (!AliasEnabled() || size == 0) {
+		return;
+	}
+	if (!GuestGpu::IsGpuThread()) {
+		// A write made when the GPU completed a tick is in order with the GPU's own work; only a write
+		// the execution thread makes ahead of the commands it has recorded can be seen too early.
+		m_alias_completion_writes.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	m_alias_execution_writes.fetch_add(1, std::memory_order_relaxed);
+	// Measurement aid (KYTY_ALIAS_SMALL_WRITES=bytes): writes of the execution thread up to this size, the
+	// labels and counters it writes for the guest, do not turn a shared buffer back into a copy.
+	static const uint64_t small_writes = AliasSetting("KYTY_ALIAS_SMALL_WRITES", 0);
+	const bool            tolerated    = size <= small_writes;
+	if (Common::FrameCensus::Enabled()) {
+		const char* site = Common::FrameCensus::t_site;
+		for (auto& slot: m_emulator_write_sites) {
+			if (slot.name == nullptr) slot.name = site;
+			if (slot.name == site) {
+				slot.count++;
+				slot.bytes += size;
+				break;
+			}
+		}
+		if (++m_emulator_frame_writes[vaddr] > 1) m_emulator_rewrites++;
+		if (const auto* owner = m_page_table.Find(vaddr >> PageTable::kPageBits); owner != nullptr && *owner) {
+			if (auto* buffer = GetBufferIfLive(*owner)) NoteChurnWrite(*buffer, size, 2);
+		}
+		for (auto page = vaddr >> CACHING_PAGEBITS; page <= (vaddr + size - 1) >> CACHING_PAGEBITS; page++) {
+			m_emulator_frame_pages[page]++;
+		}
+	}
+	if (tolerated) {
+		return;
+	}
+	std::lock_guard lock(m_alias_write_mutex);
+	if (!m_alias_writes.empty() && m_alias_writes.back() == std::pair {vaddr, size}) {
+		return;
+	}
+	if (m_alias_writes.size() < 65536) {
+		m_alias_writes.emplace_back(vaddr, size);
+	} else {
+		m_alias_writes_lost = true;
+	}
+}
+
+void BufferCache::NoteAliasDenial(uint64_t address, uint64_t size, uint8_t reason) {
+	if (!Common::FrameCensus::Enabled()) {
+		return;
+	}
+	for (auto page = address >> CACHING_PAGEBITS; page <= (address + size - 1) >> CACHING_PAGEBITS; page++) {
+		m_alias_denial_reasons.try_emplace(page, reason);
+	}
+}
+
+void BufferCache::NoteAliasUpload(Buffer& buffer, uint64_t bytes) {
+	if (AliasEnabled() && Common::FrameCensus::Enabled() && !buffer.IsHostMemory()) {
+		// Upload bytes of the buffers that stay copies, by what keeps them so.
+		size_t kind = 0;
+		if (buffer.Size() > AliasMaxSize()) {
+			kind = 6;
+		} else {
+			for (auto page = buffer.CpuAddress() >> CACHING_PAGEBITS;
+			     kind == 0 && page <= (buffer.CpuAddress() + buffer.Size() - 1) >> CACHING_PAGEBITS; page++) {
+				if (const auto it = m_alias_denial_reasons.find(page); it != m_alias_denial_reasons.end()) kind = it->second;
+			}
+		}
+		m_alias_copy_bytes[kind] += bytes;
+		m_alias_copy_uploads[kind]++;
+	}
+	if (!AliasEnabled() || buffer.IsHostMemory() || buffer.alias_queued || buffer.Size() > AliasMaxSize() ||
+	    buffer.CpuAddress() == 0 || buffer.last_upload_frame == m_gc_tick) {
+		return;
+	}
+	buffer.last_upload_frame = m_gc_tick;
+	if (++buffer.upload_frames >= AliasAfterFrames()) {
+		buffer.alias_queued = true;
+		m_alias_requests.push_back({buffer.CpuAddress(), buffer.Size()});
+	}
+}
+
+void BufferCache::ProcessAliasWork() {
+	if (!AliasEnabled()) {
+		return;
+	}
+	if (Common::FrameCensus::Enabled()) {
+		m_emulator_frames++;
+		m_emulator_distinct += m_emulator_frame_writes.size();
+		m_emulator_pages    += m_emulator_frame_pages.size();
+		for (const auto& [page, count]: m_emulator_frame_pages) {
+			const auto* owner = m_page_table.Find(page);
+			m_emulator_cached_pages += owner != nullptr && *owner ? 1 : 0;
+		}
+		m_emulator_frame_writes.clear();
+		m_emulator_frame_pages.clear();
+	}
+	std::vector<std::pair<uint64_t, uint64_t>> writes;
+	bool                                       lost = false;
+	{
+		std::lock_guard lock(m_alias_write_mutex);
+		writes.swap(m_alias_writes);
+		lost = std::exchange(m_alias_writes_lost, false);
+	}
+	const uint64_t emu_cooldown = AliasEmuCooldownFrames();
+	if (emu_cooldown != 0 && !m_alias_emu_cooldown.empty() && (m_gc_tick & 255u) == 0) {
+		std::erase_if(m_alias_emu_cooldown, [this](const auto& item) { return m_gc_tick >= item.second; });
+	}
+	for (const auto& [vaddr, size]: writes) {
+		if (!GuestRange {vaddr, size}.Valid()) {
+			continue;
+		}
+		const auto begin = Common::AlignDown(vaddr, CACHING_PAGESIZE);
+		const auto bytes = Common::AlignUp(vaddr + size, CACHING_PAGESIZE) - begin;
+		m_alias_dealias_final = true;
+		const bool hit_live   = m_alias_live != 0 && DealiasRange(begin, bytes);
+		m_alias_dealias_final = false;
+		if (hit_live) {
+			m_alias_stats.undone_emulator++;
+		}
+		if (hit_live || emu_cooldown == 0 || bytes > 4 * MiB || m_alias_emu_cooldown.size() >= 65536) {
+			(void)m_alias_denied.Add(begin, bytes);
+			NoteAliasDenial(begin, bytes, 1);
+		} else {
+			const uint64_t until = m_gc_tick + emu_cooldown;
+			for (auto page = begin >> CACHING_PAGEBITS; page <= (begin + bytes - 1) >> CACHING_PAGEBITS; ++page) {
+				m_alias_emu_cooldown[page] = until;
+			}
+		}
+	}
+	if (lost && m_alias_live != 0) {
+		// More emulator writes than were listed: no buffer may stay guest memory.
+		std::vector<BufferId> all;
+		for (const auto& [address, id]: m_buffers) {
+			if (m_slot_buffers[id].IsHostMemory()) {
+				all.push_back(id);
+			}
+		}
+		for (const auto id: all) {
+			Dealias(id);
+			m_alias_stats.undone_emulator++;
+		}
+	}
+	std::vector<AliasRequest> requests;
+	requests.swap(m_alias_requests);
+	for (const auto& request: requests) {
+		const auto it = m_buffers.find(request.address);
+		if (it == m_buffers.end()) {
+			continue;
+		}
+		const auto id     = it->second;
+		auto&      buffer = m_slot_buffers[id];
+		if (buffer.is_deleted || buffer.Size() != request.size || buffer.IsHostMemory()) {
+			continue;
+		}
+		buffer.alias_queued  = false;
+		buffer.upload_frames = 0;
+		(void)TryAlias(id);
+	}
+}
