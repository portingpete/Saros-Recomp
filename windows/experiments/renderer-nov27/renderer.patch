+		std::lock_guard lock(g_shared_mutex);
+		const auto      it = g_shared_buffers.find(handle);
+		if (it == g_shared_buffers.end()) {
+			return;
+		}
+		address = it->second.first;
+	}
+	IntoShared(site, address + offset, size);
