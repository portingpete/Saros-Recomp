+		             static_cast<unsigned long long>(changed), static_cast<unsigned long long>(zeroed),
+		             base != 0 ? 100.0 * static_cast<double>(other.changed.load(std::memory_order_relaxed)) / static_cast<double>(base) : 0.0,
+		             base != 0 ? 100.0 * static_cast<double>(other.zeroed.load(std::memory_order_relaxed)) / static_cast<double>(base) : 0.0,
+		             static_cast<unsigned long long>(count));
+	}
