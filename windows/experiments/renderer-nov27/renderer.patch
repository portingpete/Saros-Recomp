+// Frame of the last wrong answer per address, under m_gpu_peek_mutex.
+static std::unordered_map<uint64_t, uint64_t> g_gpu_peek_miss_frames;
+
+bool BufferCache::SpeculateGpuBytes(uint64_t address, const void* expected, uint32_t size) {
+	if (!GpuPeekOn() || size == 0 || size > 32 || !GuestGpu::IsGpuThread()) return false;
+	const auto* owner = m_page_table.Find(address >> PageTable::kPageBits);
+	if (owner == nullptr || !*owner) return false;
+	const auto& buffer = m_slot_buffers[*owner];
+	if (buffer.is_deleted || !buffer.IsInBounds(address, size)) return false;
+	size_t index = 0;
+	{
+		std::lock_guard lock(m_gpu_peek_mutex);
+		if (OrderedPeekOn() && FindOrdered(address, size) != nullptr) {
+			// These bytes are answered by the order of writes, where they are read.
+			return false;
+		}
+		auto*           peek = FindGpuPeek(address, size, expected, false);
+		// Bytes whose history was wrong before have to repeat four times as long before they are believed
+		// again, whatever value they hold, and after the third wrong answer they are always read: bytes
+		// that really change cost a wait each time, and a wrong answer costs a frame drawn from old data.
+		// KYTY_GPU_PEEK_LENIENT=1 (a measurement aid) forgets wrong answers and so keeps answering for
+		// bytes that change now and then.
+		static const bool lenient = [] {
+			const char* value = std::getenv("KYTY_GPU_PEEK_LENIENT");
+			return value != nullptr && value[0] == '1';
+		}();
+		// KYTY_GPU_PEEK_FORGIVE_FRAMES=n: wrong answers at an address are forgotten n frames after the last
+		// one.  Bytes that changed while a level loaded and have been steady since are then answered again;
+		// without it three wrong answers bar an address for good.
+		static const uint64_t forgive = [] {
+			const char* value = std::getenv("KYTY_GPU_PEEK_FORGIVE_FRAMES");
+			return value != nullptr ? std::strtoull(value, nullptr, 10) : 0ull;
+		}();
+		auto misses = m_gpu_peek_misses.find(address);
+		if (forgive != 0 && misses != m_gpu_peek_misses.end()) {
+			const auto last = g_gpu_peek_miss_frames.find(address);
+			if (last == g_gpu_peek_miss_frames.end() || m_gc_tick - last->second >= forgive) {
+				m_gpu_peek_misses.erase(misses);
+				misses = m_gpu_peek_misses.end();
+			}
+		}
+		const auto wrong = lenient || misses == m_gpu_peek_misses.end() ? 0u : misses->second;
+		if (peek == nullptr || wrong >= 3 || peek->confirmed < (uint64_t {GpuPeekConfirmations} << (2 * wrong))) {
+			(peek == nullptr ? m_gpu_peek_refused_missing : m_gpu_peek_refused_short)++;
+			return false;
+		}
+		g_gpu_peek_stats.assumed.fetch_add(1, std::memory_order_relaxed);
+		NoteGuardAnswer(buffer, address, expected, size);
+		if (!m_guard_collect && PredictionGuardOn()) NoteUnguardedAnswer(address);
+		if (peek->pending) return true;
+		peek->pending = true;
+		index         = static_cast<size_t>(peek - m_gpu_peeks.data());
+	}
+	auto  download = m_download_buffer.MapDownload(size, 64);
+	auto& command  = m_scheduler.Current();
+	command.EndRendering();
+	const auto              native = command.Handle();
+	vk::BufferMemoryBarrier before {};
+	before.srcAccessMask       = vk::AccessFlagBits::eMemoryRead | vk::AccessFlagBits::eMemoryWrite;
+	before.dstAccessMask       = vk::AccessFlagBits::eTransferRead;
+	before.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	before.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	before.buffer              = buffer.Handle();
+	before.offset              = 0;
+	before.size                = buffer.Size();
+	native.pipelineBarrier(vk::PipelineStageFlagBits::eAllCommands, vk::PipelineStageFlagBits::eTransfer, {}, 0, nullptr, 1,
+	                       &before, 0, nullptr);
+	const vk::BufferCopy copy {buffer.Offset(address), download.offset, size};
+	native.copyBuffer(buffer.Handle(), download.buffer->Handle(), 1, &copy);
+	auto after          = before;
+	after.srcAccessMask = vk::AccessFlagBits::eTransferWrite;
+	after.dstAccessMask = vk::AccessFlagBits::eHostRead;
+	after.buffer        = download.buffer->Handle();
+	after.offset        = download.offset;
+	after.size          = size;
+	native.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer,
+	                       vk::PipelineStageFlagBits::eAllCommands | vk::PipelineStageFlagBits::eHost, {}, 0, nullptr, 1,
+	                       &after, 0, nullptr);
+	m_scheduler.DeferHostOperation(
+	    [this, index, size, download = std::move(download)] {
+		    download.buffer->Invalidate(download.offset, size);
+		    std::lock_guard lock(m_gpu_peek_mutex);
+		    auto&           done = m_gpu_peeks[index];
+		    done.pending         = false;
+		    g_gpu_peek_stats.checked.fetch_add(1, std::memory_order_relaxed);
+		    const auto address = done.address;
+		    if (!ObserveGpuPeek(done, download.mapped)) {
+			    g_gpu_peek_stats.checked_changed.fetch_add(1, std::memory_order_relaxed);
+			    m_gpu_peek_misses[address]++;
+			    g_gpu_peek_miss_frames[address] = m_gc_tick;
+			    for (auto& other: m_gpu_peeks) {
+				    if (other.address == address) other.confirmed = 0;
+			    }
+		    }
+	    },
+	    true);
+	return true;
+}
