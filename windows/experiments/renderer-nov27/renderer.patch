+
+void CollectComputeHazardAccess(RenderContext& context, const ShaderRecompiler::IR::CompiledShaderInfo& program,
+                                const PreparedBindings& bindings, bool indirect_writes, bool guarded,
+                                uint64_t args_addr, ComputeHazardAccess& out) {
+	out.Clear();
+	if (program.info.uses_gds || program.info.bvh || bindings.shared_memory.buffer != nullptr ||
+	    bindings.gds.buffer != nullptr || indirect_writes) {
+		out.write_opaque = true;
+		out.read_opaque  = true;
+	}
+	if (program.info.uses_dma) {
+		out.read_opaque = true;
+		if (MayWriteThroughDeviceAddresses(program)) {
+			out.write_opaque = true;
+		}
+	}
+	if (program.info.uses_image_heap) {
+		out.read_opaque = true;
+	}
+	if (!bindings.table_images.empty()) {
+		out.read_opaque = true;
+		for (const auto& img: program.info.images) {
+			if (img.table_capacity != 0u && img.written) {
+				out.write_opaque = true;
+				break;
+			}
+		}
+	}
+	if (guarded) {
+		out.read_opaque = true;
+	}
+	if (args_addr != 0) {
+		PushAlignedHazardRange(out.reads, args_addr, sizeof(vk::DispatchIndirectCommand));
+	}
+	for (const auto& meta: program.info.buffers) {
+		if (meta.descriptor_index >= bindings.buffer_sources.size()) {
+			continue;
+		}
+		const auto& src = bindings.buffer_sources[meta.descriptor_index];
+		if (src.address == 0 || src.size == 0) {
+			continue;
+		}
+		if (meta.written) {
+			PushAlignedHazardRange(out.writes, src.address, src.size);
+		}
+		PushAlignedHazardRange(out.reads, src.address, src.size);
+	}
+	auto& textures = context.GetTextureCache();
+	const size_t img_count = std::min(program.info.images.size(), bindings.images.size());
+	for (size_t i = 0; i < img_count; ++i) {
+		const auto& meta = program.info.images[i];
+		if (meta.heap) {
+			continue;
+		}
+		const auto id = bindings.images[i].image_id;
+		if (!id) {
+			continue;
+		}
+		const uint64_t tag = ImageHazardTagBit | uint64_t {id.index};
+		const auto&    img = textures.GetImage(id);
+		if (meta.written) {
+			out.writes.push_back({tag, tag + 1u});
+			if (img.track_addr < img.track_addr_end) {
+				PushAlignedHazardRange(out.writes, img.track_addr, img.track_addr_end - img.track_addr);
+			}
+		}
+		out.reads.push_back({tag, tag + 1u});
+		if (img.track_addr < img.track_addr_end) {
+			PushAlignedHazardRange(out.reads, img.track_addr, img.track_addr_end - img.track_addr);
+		}
+	}
+}
