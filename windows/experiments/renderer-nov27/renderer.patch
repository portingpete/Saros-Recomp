+inline uint32_t BeginSarosBucket(RenderContext& context, const CommandRecorder& command,
+                                 SarosBucket bucket, uint64_t tag = 0) {
+	if (!SarosBucketTimerState::Enabled() || !GuestGpu::IsGpuThread()) {
+		return kInvalidSarosBucket;
+	}
+	auto& state = SarosBucketTimerState::Instance();
+	const int frame = context.GetGpu().GetFrameNum();
+	if (state.active && state.active->frame != frame) {
+		auto finished = std::move(state.active);
+		state.active_depth    = 0;
+		state.graphics_handle = kInvalidSarosBucket;
+		SarosBucketTimerState::FlushFrame(context, std::move(finished));
+	}
+	if (frame <= 0 || (frame % 60) != 0) {
+		return kInvalidSarosBucket;
+	}
+	if (state.active_depth != 0) {
+		return kInvalidSarosBucket;
+	}
+	auto& graphics = context.GetGraphics();
+	if (!SarosBucketTimerState::Supported(graphics)) {
+		return kInvalidSarosBucket;
+	}
+	if (!state.active) {
+		if (context.GetCommandScheduler().Current().IsRendering()) {
+			return kInvalidSarosBucket;
+		}
+		vk::QueryPoolCreateInfo info {};
+		info.queryType  = vk::QueryType::eTimestamp;
+		info.queryCount = SarosBucketTimerState::kMaxQueries;
+		vk::QueryPool pool {};
+		if (graphics.device.createQueryPool(&info, nullptr, &pool) != vk::Result::eSuccess) {
+			return kInvalidSarosBucket;
+		}
+		auto cap   = std::make_shared<SarosBucketTimerState::FrameCapture>();
+		cap->frame = frame;
+		cap->pool  = pool;
+		cap->entries.reserve(2048);
+		command.Custom([pool](vk::CommandBuffer c) {
+			c.resetQueryPool(pool, 0, SarosBucketTimerState::kMaxQueries);
+		});
+		state.active = std::move(cap);
+	}
+	auto& cap = *state.active;
+	if (cap.next_q + 2u > SarosBucketTimerState::kMaxQueries) {
+		cap.truncated = true;
+		return kInvalidSarosBucket;
+	}
+	const uint32_t q_start = cap.next_q++;
+	const auto     pool    = cap.pool;
+	command.Custom([pool, q_start](vk::CommandBuffer c) {
+		c.writeTimestamp(vk::PipelineStageFlagBits::eBottomOfPipe, pool, q_start);
+	});
+	const uint32_t handle = static_cast<uint32_t>(cap.entries.size());
+	cap.entries.push_back(SarosBucketTimerState::Entry {
+	    .bucket     = bucket,
+	    .q_start    = q_start,
+	    .q_end      = UINT32_MAX,
+	    .tag        = tag,
+	    .start_tick = context.GetCommandScheduler().CurrentTick(),
+	    .end_tick   = 0,
+	});
+	state.active_depth = 1;
+	return handle;
+}
+
+inline void EndSarosBucket(RenderContext& context, const CommandRecorder& command, uint32_t handle) {
+	if (handle == kInvalidSarosBucket) {
+		return;
+	}
+	auto& state = SarosBucketTimerState::Instance();
+	if (!state.active || handle >= state.active->entries.size()) {
+		state.active_depth = 0;
+		return;
+	}
+	auto& cap = *state.active;
+	if (cap.next_q < SarosBucketTimerState::kMaxQueries) {
+		const uint32_t q_end = cap.next_q++;
+		const auto     pool  = cap.pool;
+		command.Custom([pool, q_end](vk::CommandBuffer c) {
+			c.writeTimestamp(vk::PipelineStageFlagBits::eBottomOfPipe, pool, q_end);
+		});
+		cap.entries[handle].q_end    = q_end;
+		cap.entries[handle].end_tick = context.GetCommandScheduler().CurrentTick();
+	}
+	if (state.active_depth > 0) {
+		--state.active_depth;
+	}
+}
