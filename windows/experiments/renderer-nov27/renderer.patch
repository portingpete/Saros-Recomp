+inline bool                               g_failed_pending = false;
+inline uint64_t                           g_last_report    = 0;
+
+inline void NoteCheck(uint64_t shader, uint64_t ns, bool ok, const ShaderModule* module,
+                      const ShaderRecompiler::IR::ResourceSnapshot* resources) {
+	auto& tally = g_tallies[shader];
+	tally.checks++;
+	tally.ns += ns;
+	tally.slow += ns > 100'000 ? 1 : 0;
+	g_failed_pending = false;
+	if (!ok) {
+		tally.failed++;
+		if (resources != nullptr) {
+			g_failed_shader    = shader;
+			g_failed_module    = module;
+			g_failed_resources = *resources;
+			g_failed_pending   = true;
+		}
+	}
+}
