+
+// The renderer recorded a GPU write into a buffer that is guest memory: the GPU will change the guest's
+// bytes when it gets there, whatever the guest has done with them meanwhile.
+inline void IntoShared(uint32_t site, uint64_t address, uint64_t size) noexcept {
+	Note(GpuIntoShared, address, size, site);
+	const auto seen = g_into_shared.fetch_add(1, std::memory_order_relaxed) + 1;
+	if (seen <= 24 || seen % 4096 == 0) {
+		std::fprintf(stderr, "[write-journal] GPU write recorded into a shared buffer at site %u: guest 0x%llx, %llu bytes (%llu so far)" "\n",
+		             site, static_cast<unsigned long long>(address), static_cast<unsigned long long>(size),
+		             static_cast<unsigned long long>(seen));
